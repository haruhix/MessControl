Artifacts/CarriesStage2/CombatPool_v1/Video.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Preserve captured report/manifest bytes used by the Cataclysm evidence hashes.
Artifacts/CataclysmRaft_20261014/*.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
Artifacts/CataclysmGameplay_20261014/*.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
Artifacts/CataclysmStorm_20261014/*.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
Artifacts/RowingAnimation_20261014/*.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
