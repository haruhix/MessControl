   Begin Object Name="MaterialExpressionCustom_0" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/Gameplay/Cold/M_PlayerIceCoating.M_PlayerIceCoating:MaterialExpressionCustom_0'"
      Code="float a=saturate(Amount);\nif(a<=0.001) return 0.0;\nfloat threshold=lerp(0.89,0.04,a);\nfloat crystals=smoothstep(threshold,threshold+clamp(Softness,0.005,0.30),saturate(Frost));\nreturn crystals*smoothstep(0.0,0.12,a);"
      OutputType=CMOT_Float1
      Description="Frost crystals grow with the replicated freeze meter"
      Inputs(0)=(InputName="Frost",Input=(Expression="/Script/Engine.MaterialExpressionTextureSampleParameter2D'M_PlayerIceCoating:MaterialExpressionTextureSampleParameter2D_0'",OutputIndex=1,Mask=1,MaskR=1))
      Inputs(1)=(InputName="Amount",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'M_PlayerIceCoating:MaterialExpressionScalarParameter_1'"))
      Inputs(2)=(InputName="Softness",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'M_PlayerIceCoating:MaterialExpressionScalarParameter_4'"))
      MaterialExpressionEditorX=-990
      MaterialExpressionEditorY=1700
      MaterialExpressionGuid=D57A6A5140DE0AF7EBCDC39FF5B8E4E0
      Material="/Script/Engine.Material'M_PlayerIceCoating'"
   End Object
