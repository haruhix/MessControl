    {
      "path": "/Game/Gameplay/Care/M_ArenaToothRelief.M_ArenaToothRelief:MaterialExpressionCustom_2",
      "type": "MaterialExpressionCustom",
      "desc": "",
      "description": "MC Care: anchored plaque detail normal slope",
      "code": "\n[branch] if (Amount<=.0001) return float3(0,0,0);\nfloat3 q=P*Scale/max(Tile,8.0)+Seed*float3(.37,.19,.73);\nfloat3 w=abs(normalize(N)); w*=w; w*=w; w/=max(dot(w,1),.0001);\n// BC5 normal textures store signed tangent X/Y in their two sampled channels.\n// Reconstruct Z, then express the three projection slopes in rest-space cm.\nfloat2 x=Texture2DSample(NormalMap,NormalMapSampler,q.yz).rg*2-1;\nfloat2 y=Texture2DSample(NormalMap,NormalMapSampler,q.xz).rg*2-1;\nfloat2 z=Texture2DSample(NormalMap,NormalMapSampler,q.xy).rg*2-1;\nx/=-max(sqrt(saturate(1-dot(x,x))),.35);\ny/=-max(sqrt(saturate(1-dot(y,y))),.35);\nz/=-max(sqrt(saturate(1-dot(z,z))),.35);\nreturn float3(0,x.x,x.y)*w.x+float3(y.x,0,y.y)*w.y+float3(z.x,z.y,0)*w.z;\n",
      "inputs": [
        "P",
        "N",
        "Scale",
        "Tile",
        "Seed",
        "Amount",
        "NormalMap"
      ],
