    {
      "path": "/Game/Gameplay/Care/M_ArenaToothRelief.M_ArenaToothRelief:MaterialExpressionCustom_5",
      "type": "MaterialExpressionCustom",
      "desc": "",
      "description": "MC Care: coatingColor",
      "code": "\n// The supplied ochre wash and brown specks retain their own size in cm.\nfloat3 color=lerp(Pigment,float3(.79,.48,.14),.10);\nfloat margin=1-smoothstep(.23,.70,F.x);\ncolor=lerp(color,float3(.90,.73,.37),margin*.20);\nreturn lerp(color*max(ArtistTint,0),float3(.92,.97,.94),F.y*.92);\n",
      "inputs": [
        "P",
        "N",
        "Tex",
        "Tint",
        "F",
        "D",
        "Light",
        "Dark",
        "Rim",
        "Pigment",
        "ArtistTint"
      ],
      "sources": [
