    {
      "path": "/Game/Gameplay/Care/M_ArenaToothRelief.M_ArenaToothRelief:MaterialExpressionCustom_6",
      "type": "MaterialExpressionCustom",
      "desc": "",
      "description": "MC Care: coatingRoughness",
      "code": "return lerp(saturate(Roughness+(D.z-.5)*.14),.43,F.y);",
      "inputs": [
        "F",
