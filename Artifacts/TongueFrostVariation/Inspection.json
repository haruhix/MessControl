        "/Game/Gameplay/Cold/Frost/M_TongueFrost.M_TongueFrost:MaterialExpressionScalarParameter_9",
        "/Game/Gameplay/Cold/Frost/M_TongueFrost.M_TongueFrost:MaterialExpressionScalarParameter_10"
      ],
      "description": "Smooth frost fade outside the current and next warm circles",
      "code": "float w=max(Width,1.0);\nfloat r=max(Radius,0.0);\nfloat nr=max(NextRadius,0.0);\nfloat outside=smoothstep(r,r+w,length(P.xy-Center.xy));\nfloat nextOutside=smoothstep(nr,nr+w,length(P.xy-NextCenter.xy));\nreturn lerp(1.0,outside,saturate(Enabled))*lerp(1.0,nextOutside,saturate(NextEnabled));"
    },
