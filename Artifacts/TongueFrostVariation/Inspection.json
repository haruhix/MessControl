      "sources": [
        "/Game/Gameplay/Cold/Frost/M_TongueFrost.M_TongueFrost:MaterialExpressionWorldPosition_0",
        "/Game/Gameplay/Cold/Frost/M_TongueFrost.M_TongueFrost:MaterialExpressionVectorParameter_3",
        "/Game/Gameplay/Cold/Frost/M_TongueFrost.M_TongueFrost:MaterialExpressionScalarParameter_6",
        "/Game/Gameplay/Cold/Frost/M_TongueFrost.M_TongueFrost:MaterialExpressionScalarParameter_7",
        "/Game/Gameplay/Cold/Frost/M_TongueFrost.M_TongueFrost:MaterialExpressionVectorParameter_4",
