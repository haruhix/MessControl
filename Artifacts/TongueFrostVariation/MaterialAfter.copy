   End Object
   Begin Object Name="MaterialExpressionCustom_1" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/Gameplay/Cold/Frost/M_TongueFrost.M_TongueFrost:MaterialExpressionCustom_1'"
      Code="float edge=max(Variation,0.0);\nfloat variation=saturate(edge/65.0);\nfloat w=max(Width,1.0)*lerp(1.0,lerp(0.40,1.35,Fields.b),variation);\nfloat fringe=edge*(0.12+0.88*Fields.g);\nfloat r=max(Radius,0.0), nr=max(NextRadius,0.0);\nfloat outside=smoothstep(r+fringe,r+fringe+w,length(P.xy-Center.xy));\nfloat nextOutside=smoothstep(nr+fringe,nr+fringe+w,length(P.xy-NextCenter.xy));\nreturn lerp(1.0,outside,saturate(Enabled))*lerp(1.0,nextOutside,saturate(NextEnabled));"
      OutputType=CMOT_Float1
      Description="Uneven thaw fringe with locally varying softness, outside both gameplay-safe circles"
      Inputs(0)=(InputName="P",Input=(Expression="/Script/Engine.MaterialExpressionWorldPosition'M_TongueFrost:MaterialExpressionWorldPosition_0'",Mask=1,MaskR=1,MaskG=1,MaskB=1))
      Inputs(1)=(InputName="Center",Input=(Expression="/Script/Engine.MaterialExpressionVectorParameter'M_TongueFrost:MaterialExpressionVectorParameter_3'",Mask=1,MaskR=1,MaskG=1,MaskB=1))
      Inputs(2)=(InputName="Radius",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'M_TongueFrost:MaterialExpressionScalarParameter_6'"))
      Inputs(3)=(InputName="Enabled",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'M_TongueFrost:MaterialExpressionScalarParameter_7'"))
      Inputs(4)=(InputName="NextCenter",Input=(Expression="/Script/Engine.MaterialExpressionVectorParameter'M_TongueFrost:MaterialExpressionVectorParameter_4'",Mask=1,MaskR=1,MaskG=1,MaskB=1))
      Inputs(5)=(InputName="NextRadius",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'M_TongueFrost:MaterialExpressionScalarParameter_8'"))
      Inputs(6)=(InputName="NextEnabled",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'M_TongueFrost:MaterialExpressionScalarParameter_9'"))
      Inputs(7)=(InputName="Width",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'M_TongueFrost:MaterialExpressionScalarParameter_10'"))
      Inputs(8)=(InputName="Fields",Input=(Expression="/Script/Engine.MaterialExpressionCustom'M_TongueFrost:MaterialExpressionCustom_4'"))
      Inputs(9)=(InputName="Variation",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'M_TongueFrost:MaterialExpressionScalarParameter_19'"))
      MaterialExpressionEditorX=-2110
      MaterialExpressionEditorY=3320
      MaterialExpressionGuid=E82A77EE4AADCA5F2A9A36B679D8833A
      Material="/Script/Engine.Material'M_TongueFrost'"
   End Object
