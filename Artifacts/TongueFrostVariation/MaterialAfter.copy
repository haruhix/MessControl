   Begin Object Name="MaterialExpressionCustom_11" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/Gameplay/Cold/Frost/M_TongueFrost.M_TongueFrost:MaterialExpressionCustom_11'"
      Code="return normalize(lerp(float3(0,0,1),Normal,0.25));"
      Description="Softer relief under rough frost"
