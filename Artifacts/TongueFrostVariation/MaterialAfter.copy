   Begin Object Name="MaterialExpressionCustom_5" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/Gameplay/Cold/Frost/M_TongueFrost.M_TongueFrost:MaterialExpressionCustom_5'"
      Code="float a=saturate(Amount);\nif(a<=0.001) return float4(0,0,0,0);\nfloat threshold=lerp(1.08,1.0-clamp(Density,0.02,0.98),a);\nfloat plate=smoothstep(threshold,threshold+max(Softness,0.005),Fields.r);\nfloat region=smoothstep(1.0-saturate(Clumps),1.18-saturate(Clumps),Fields.g);\nfloat rim=4.0*plate*(1.0-plate);\nfloat cluster=smoothstep(0.24,0.57,Fields.r)*saturate(region*0.85+rim*0.65);\nfloat frost=saturate(Crystals)*cluster;\nfloat total=max(plate,frost);\nfloat mix=saturate(frost*1.85/max(total,0.001))*saturate(FrostStrength);\nreturn float4(total,mix,plate,region);"
      OutputType=CMOT_Float4
      Description="Growing ice plates with clustered frost and exposed tissue between them"
      Inputs(0)=(InputName="Fields",Input=(Expression="/Script/Engine.MaterialExpressionCustom'M_TongueFrost:MaterialExpressionCustom_4'"))
      Inputs(1)=(InputName="Amount",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'M_TongueFrost:MaterialExpressionScalarParameter_1'"))
      Inputs(2)=(InputName="Density",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'M_TongueFrost:MaterialExpressionScalarParameter_16'"))
      Inputs(3)=(InputName="Softness",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'M_TongueFrost:MaterialExpressionScalarParameter_17'"))
      Inputs(4)=(InputName="Clumps",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'M_TongueFrost:MaterialExpressionScalarParameter_18'"))
      Inputs(5)=(InputName="Crystals",Input=(Expression="/Script/Engine.MaterialExpressionCustom'M_TongueFrost:MaterialExpressionCustom_0'"))
      Inputs(6)=(InputName="FrostStrength",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'M_TongueFrost:MaterialExpressionScalarParameter_5'"))
      MaterialExpressionEditorX=-3460
      MaterialExpressionEditorY=4760
      MaterialExpressionGuid=98F3ED54495EDA1D92E3D5ADB9FD00EF
      Material="/Script/Engine.Material'M_TongueFrost'"
   End Object
   Begin Object Name="MaterialExpressionScalarParameter_18" ExportPath="/Script/Engine.MaterialExpressionScalarParameter'/Game/Gameplay/Cold/Frost/M_TongueFrost.M_TongueFrost:MaterialExpressionScalarParameter_18'"
      DefaultValue=0.670000
