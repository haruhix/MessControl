   Begin Object Name="MaterialExpressionMultiply_5" ExportPath="/Script/Engine.MaterialExpressionMultiply'/Game/Gameplay/Cold/Frost/M_TongueFrost.M_TongueFrost:MaterialExpressionMultiply_5'"
      A=(Expression="/Script/Engine.MaterialExpressionComponentMask'M_TongueFrost:MaterialExpressionComponentMask_1'")
      B=(Expression="/Script/Engine.MaterialExpressionCustom'M_TongueFrost:MaterialExpressionCustom_1'")
      MaterialExpressionEditorX=-1660
      MaterialExpressionEditorY=3190
      MaterialExpressionGuid=801C15214FDBB5CDD4118FB4A644958C
      Material="/Script/Engine.Material'M_TongueFrost'"
