   Begin Object Name="MaterialExpressionCustom_4" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/Gameplay/Cold/Frost/M_TongueFrost.M_TongueFrost:MaterialExpressionCustom_4'"
      Code="struct TongueIceField\n{\n    float hash(float2 p)\n    {\n        float3 q=frac(float3(p.x,p.y,p.x)*0.1031);\n        q+=dot(q,q.yzx+33.33);\n        return frac((q.x+q.y)*q.z);\n    }\n    float noise(float2 p)\n    {\n        float2 i=floor(p), f=frac(p);\n        float2 u=f*f*(3.0-2.0*f);\n        return lerp(lerp(hash(i),hash(i+float2(1,0)),u.x),\n                    lerp(hash(i+float2(0,1)),hash(i+1.0),u.x),u.y);\n    }\n    float fbm(float2 p)\n    {\n        return noise(p)*0.65+noise(p*2.07+13.4)*0.25+noise(p*4.13-8.7)*0.10;\n    }\n};\nTongueIceField f;\nfloat2 p=UV*max(Scale,0.1)+Offset.xy;\nfloat2 warp=float2(f.noise(p*0.83+6.2),f.noise(p*0.91-5.4))-0.5;\nfloat2 q=p+warp*1.8;\nreturn float4(f.fbm(q),f.noise(q*2.6+13.4),f.fbm(q*1.42-5.3),f.noise(q*7.0+22.1));"
      OutputType=CMOT_Float4
      Description="Stable UV field: ice islands, frost clumps, thaw breakup and gloss variation"
      Inputs(0)=(InputName="UV",Input=(Expression="/Script/Engine.MaterialExpressionTextureCoordinate'M_TongueFrost:MaterialExpressionTextureCoordinate_4'"))
      Inputs(1)=(InputName="Scale",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'M_TongueFrost:MaterialExpressionScalarParameter_15'"))
      Inputs(2)=(InputName="Offset",Input=(Expression="/Script/Engine.MaterialExpressionVectorParameter'M_TongueFrost:MaterialExpressionVectorParameter_6'",Mask=1,MaskR=1,MaskG=1,MaskB=1))
      MaterialExpressionEditorX=-3950
      MaterialExpressionEditorY=4710
      MaterialExpressionGuid=2F1B50C748A690F1DF02F990E11B2E29
      Material="/Script/Engine.Material'M_TongueFrost'"
   End Object
   Begin Object Name="MaterialExpressionVectorParameter_6" ExportPath="/Script/Engine.MaterialExpressionVectorParameter'/Game/Gameplay/Cold/Frost/M_TongueFrost.M_TongueFrost:MaterialExpressionVectorParameter_6'"
      DefaultValue=(R=0.310000,G=4.700000,B=0.000000,A=1.000000)
