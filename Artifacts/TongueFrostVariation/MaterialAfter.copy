   Begin Object Name="MaterialExpressionCustom_12" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/Gameplay/Cold/Frost/M_TongueFrost.M_TongueFrost:MaterialExpressionCustom_12'"
      Code="return smoothstep(0.32,0.68,Fields.r)*saturate(Amount)*max(Thickness,0.0)*Warmth;"
      OutputType=CMOT_Float1
      Description="Vertex-safe uneven plate thickness, reduced by warmth"
      Inputs(0)=(InputName="Fields",Input=(Expression="/Script/Engine.MaterialExpressionCustom'M_TongueFrost:MaterialExpressionCustom_4'"))
      Inputs(1)=(InputName="Amount",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'M_TongueFrost:MaterialExpressionScalarParameter_1'"))
      Inputs(2)=(InputName="Thickness",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'M_TongueFrost:MaterialExpressionScalarParameter_2'"))
      Inputs(3)=(InputName="Warmth",Input=(Expression="/Script/Engine.MaterialExpressionCustom'M_TongueFrost:MaterialExpressionCustom_1'"))
      MaterialExpressionEditorX=-1460
      MaterialExpressionEditorY=6730
      MaterialExpressionGuid=6A51CE7A4D579F3FBF74719F7F7D5D82
      Material="/Script/Engine.Material'M_TongueFrost'"
   End Object
