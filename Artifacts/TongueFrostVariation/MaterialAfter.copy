   Begin Object Name="MaterialExpressionComponentMask_1" ExportPath="/Script/Engine.MaterialExpressionComponentMask'/Game/Gameplay/Cold/Frost/M_TongueFrost.M_TongueFrost:MaterialExpressionComponentMask_1'"
      Input=(Expression="/Script/Engine.MaterialExpressionCustom'M_TongueFrost:MaterialExpressionCustom_5'")
      R=True
      MaterialExpressionEditorX=-2990
