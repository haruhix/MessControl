   Begin Object Name="MaterialExpressionCustom_5" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/Art/Materials/Arena/RainDrips/M_Roof_RainDrips.M_Roof_RainDrips:MaterialExpressionCustom_5'"
      Code="return lerp(Spec,max(Spec,0.5),saturate(Mask));"
      OutputType=CMOT_Float1
      Description="Water dielectric specular over original surface"
      Inputs(0)=(InputName="Spec",Input=(Expression="/Script/Engine.MaterialExpressionMultiply'M_Roof_RainDrips:MaterialExpressionMultiply_12'"))
      Inputs(1)=(InputName="Mask",Input=(Expression="/Script/Engine.MaterialExpressionComponentMask'M_Roof_RainDrips:MaterialExpressionComponentMask_4'"))
      MaterialExpressionEditorX=-320
      MaterialExpressionEditorY=2540
      MaterialExpressionGuid=F127B02E4A2B04ED872675948F0F993A
      Material="/Script/Engine.Material'M_Roof_RainDrips'"
   End Object
   Begin Object Name="MaterialExpressionCustom_4" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/Art/Materials/Arena/RainDrips/M_Roof_RainDrips.M_Roof_RainDrips:MaterialExpressionCustom_4'"
      Code="return lerp(Rough, saturate(WaterRough), saturate(pow(max(Mask,0.0),0.55)));"
      OutputType=CMOT_Float1
      Description="Moving water has a smooth reflective finish"
      Inputs(0)=(InputName="Rough",Input=(Expression="/Script/Engine.MaterialExpressionMultiply'M_Roof_RainDrips:MaterialExpressionMultiply_13'"))
      Inputs(1)=(InputName="Mask",Input=(Expression="/Script/Engine.MaterialExpressionComponentMask'M_Roof_RainDrips:MaterialExpressionComponentMask_4'"))
      Inputs(2)=(InputName="WaterRough",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'M_Roof_RainDrips:MaterialExpressionScalarParameter_24'"))
      MaterialExpressionEditorX=-320
      MaterialExpressionEditorY=2340
      MaterialExpressionGuid=24D948CF45D5FF70236F9885532B219F
      Material="/Script/Engine.Material'M_Roof_RainDrips'"
   End Object
   Begin Object Name="MaterialExpressionCustom_3" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/Art/Materials/Arena/RainDrips/M_Roof_RainDrips.M_Roof_RainDrips:MaterialExpressionCustom_3'"
      Code="return Base * (1.0 - saturate(Mask)*saturate(Darkening));"
      Description="Wet rivulets subtly darken original albedo"
      Inputs(0)=(InputName="Base",Input=(Expression="/Script/Engine.MaterialExpressionLinearInterpolate'M_Roof_RainDrips:MaterialExpressionLinearInterpolate_1'"))
      Inputs(1)=(InputName="Mask",Input=(Expression="/Script/Engine.MaterialExpressionComponentMask'M_Roof_RainDrips:MaterialExpressionComponentMask_4'"))
      Inputs(2)=(InputName="Darkening",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'M_Roof_RainDrips:MaterialExpressionScalarParameter_25'"))
      MaterialExpressionEditorX=-320
      MaterialExpressionEditorY=2120
      MaterialExpressionGuid=DECE12594A0E6F3C56A726BED54AB562
      Material="/Script/Engine.Material'M_Roof_RainDrips'"
   End Object
   Begin Object Name="MaterialExpressionCustom_2" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/Art/Materials/Arena/RainDrips/M_Roof_RainDrips.M_Roof_RainDrips:MaterialExpressionCustom_2'"
      Code="float3 b=normalize(Base); b.xy *= 1.0-saturate(Mask)*0.75; return normalize(b+Delta);"
      Description="Blend water ridges with original roof normal"
      Inputs(0)=(InputName="Base",Input=(Expression="/Script/Engine.MaterialExpressionNormalize'M_Roof_RainDrips:MaterialExpressionNormalize_1'"))
      Inputs(1)=(InputName="Delta",Input=(Expression="/Script/Engine.MaterialExpressionTransform'M_Roof_RainDrips:MaterialExpressionTransform_0'"))
      Inputs(2)=(InputName="Mask",Input=(Expression="/Script/Engine.MaterialExpressionComponentMask'M_Roof_RainDrips:MaterialExpressionComponentMask_4'"))
      MaterialExpressionEditorX=-320
      MaterialExpressionEditorY=1800
      MaterialExpressionGuid=EC2CB6134A54372A19B07CB5C2EFEFF9
      Material="/Script/Engine.Material'M_Roof_RainDrips'"
   End Object
   Begin Object Name="MaterialExpressionCustom_1" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/Art/Materials/Arena/RainDrips/M_Roof_RainDrips.M_Roof_RainDrips:MaterialExpressionCustom_1'"
      Code="\nfloat3 n = normalize(N);\nfloat2 weights = pow(abs(n.xy), 4.0);\nweights /= max(weights.x + weights.y, 0.0001);\nfloat wall = saturate((1.0 - abs(n.z) - 0.08) / 0.72);\nwall = wall * wall * (3.0 - 2.0 * wall);\nfloat2 uvX = float2(P.y / max(Width,1.0), -P.z / max(Height,1.0));\nfloat2 uvY = float2(P.x / max(Width,1.0), -P.z / max(Height,1.0));\nfloat4 dx = Texture2DSample(Drips, DripsSampler, uvX);\nfloat4 dy = Texture2DSample(Drips, DripsSampler, uvY);\nfloat permeability = saturate(Permeability);\nfloat vx = max(Speed,0.0) * lerp(0.55 + dx.a * 0.9, 0.10 + dx.a * 0.18, permeability);\nfloat vy = max(Speed,0.0) * lerp(0.55 + dy.a * 0.9, 0.10 + dy.a * 0.18, permeability);\n// World Z plus time moves the head downward, with its fading trail above it.\nfloat4 rx = Texture2DSampleLevel(Ramp, RampSampler, float2(0.5, frac(-uvX.y + T*vx + dx.a)), 0);\nfloat4 ry = Texture2DSampleLevel(Ramp, RampSampler, float2(0.5, frac(-uvY.y + T*vy + dy.a)), 0);\nfloat mx = saturate(dx.b * lerp(rx.a, rx.r, permeability));\nfloat my = saturate(dy.b * lerp(ry.a, ry.r, permeability));\nfloat mask = saturate((mx * weights.x + my * weights.y) * wall * saturate(Amount));\nfloat2 sx = (dx.rg * 2.0 - 1.0) * lerp(rx.a,rx.r,permeability);\nfloat2 sy = (dy.rg * 2.0 - 1.0) * lerp(ry.a,ry.r,permeability);\n// RGB normal channels remain linear data. Project slopes onto the curved wall.\nfloat3 slope = float3(sy.x*weights.y, sx.x*weights.x,\n                    -sx.y*weights.x - sy.y*weights.y);\nslope -= n * dot(slope,n);\nfloat3 delta = slope * Strength * wall * saturate(Amount);\nreturn float4(delta,mask);\n"
      OutputType=CMOT_Float4
      Description="Rain rivulets | RG normal, B path, A timing | world Z down"
      Inputs(0)=(InputName="P",Input=(Expression="/Script/Engine.MaterialExpressionWorldPosition'M_Roof_RainDrips:MaterialExpressionWorldPosition_2'",Mask=1,MaskR=1,MaskG=1,MaskB=1))
      Inputs(1)=(InputName="N",Input=(Expression="/Script/Engine.MaterialExpressionVertexNormalWS'M_Roof_RainDrips:MaterialExpressionVertexNormalWS_1'"))
      Inputs(2)=(InputName="T",Input=(Expression="/Script/Engine.MaterialExpressionTime'M_Roof_RainDrips:MaterialExpressionTime_1'"))
      Inputs(3)=(InputName="Drips",Input=(Expression="/Script/Engine.MaterialExpressionTextureObjectParameter'M_Roof_RainDrips:MaterialExpressionTextureObjectParameter_2'"))
      Inputs(4)=(InputName="Ramp",Input=(Expression="/Script/Engine.MaterialExpressionTextureObjectParameter'M_Roof_RainDrips:MaterialExpressionTextureObjectParameter_3'"))
      Inputs(5)=(InputName="Amount",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'M_Roof_RainDrips:MaterialExpressionScalarParameter_9'"))
      Inputs(6)=(InputName="Speed",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'M_Roof_RainDrips:MaterialExpressionScalarParameter_20'"))
      Inputs(7)=(InputName="Width",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'M_Roof_RainDrips:MaterialExpressionScalarParameter_21'"))
      Inputs(8)=(InputName="Height",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'M_Roof_RainDrips:MaterialExpressionScalarParameter_22'"))
      Inputs(9)=(InputName="Strength",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'M_Roof_RainDrips:MaterialExpressionScalarParameter_23'"))
      Inputs(10)=(InputName="Permeability",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'M_Roof_RainDrips:MaterialExpressionScalarParameter_26'"))
      MaterialExpressionEditorX=-1400
      MaterialExpressionEditorY=1800
      MaterialExpressionGuid=C5DFC4E342ACE541335BFD94321393FA
      Material="/Script/Engine.Material'M_Roof_RainDrips'"
   End Object
   Begin Object Name="MaterialExpressionCustom_0" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/Art/Materials/Arena/RainDrips/M_Roof_RainDrips.M_Roof_RainDrips:MaterialExpressionCustom_0'"
      Code="\nfloat3 toFocus=Focus-Camera;\nfloat viewDistance=max(length(toFocus),1.0);\nfloat3 axis=toFocus/viewDistance;\nfloat3 surface=P-Camera;\nfloat depth=dot(surface,axis);\n// A circular aperture on the camera-to-avatar ray; far walls stay opaque.\nfloat radial=length(surface-axis*depth);\nfloat radius=max(Settings.y*max(depth,0.0)/viewDistance,1.0);\nfloat feather=clamp(Settings.z,.02,.8);\nfloat circle=1.0-smoothstep(radius*(1.0-feather),radius,radial);\nfloat inFront=step(-2.0,depth)*(1.0-smoothstep(viewDistance-15.0,viewDistance+15.0,depth));\nreturn 1.0-saturate(Settings.x)*saturate(Enabled)*circle*inFront;\n"
      OutputType=CMOT_Float1
      Description="MC Camera: radial wall coverage"
      Inputs(0)=(InputName="P",Input=(Expression="/Script/Engine.MaterialExpressionWorldPosition'M_Roof_RainDrips:MaterialExpressionWorldPosition_0'",Mask=1,MaskR=1,MaskG=1,MaskB=1))
      Inputs(1)=(InputName="Camera",Input=(Expression="/Script/Engine.MaterialExpressionCameraPositionWS'M_Roof_RainDrips:MaterialExpressionCameraPositionWS_0'"))
      Inputs(2)=(InputName="Focus",Input=(Expression="/Script/Engine.MaterialExpressionVectorParameter'M_Roof_RainDrips:MaterialExpressionVectorParameter_0'",Mask=1,MaskR=1,MaskG=1,MaskB=1))
      Inputs(3)=(InputName="Settings",Input=(Expression="/Script/Engine.MaterialExpressionVectorParameter'M_Roof_RainDrips:MaterialExpressionVectorParameter_2'",OutputIndex=5,Mask=1,MaskR=1,MaskG=1,MaskB=1,MaskA=1))
      Inputs(4)=(InputName="Enabled",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'M_Roof_RainDrips:MaterialExpressionScalarParameter_0'"))
      MaterialExpressionEditorX=1400
      MaterialExpressionEditorY=700
      MaterialExpressionGuid=868A79B343B588D655FEB0B694762B0A
      Material="/Script/Engine.Material'M_Roof_RainDrips'"
   End Object
