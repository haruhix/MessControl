   Begin Object Name="MaterialExpressionCustom_0" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/Art/Materials/ThroatEdgeFade/M_ExitClimate_EdgeFade.M_ExitClimate_EdgeFade:MaterialExpressionCustom_0'"
      Code="\nfloat grains=frac(sin(dot(floor(P*.9),float3(12.9898,78.233,45.164)))*43758.5453);\nfloat wisps=.5+.5*sin(P.x*.021+sin(P.y*.018)*2+P.z*.015);\nfloat coat=saturate(.38+.50*saturate(N.z)+.28*wisps+.12*grains);\nreturn saturate(Cold)*coat;\n"
      OutputType=CMOT_Float1
      Description="Mouth climate frost crystal coverage"
      Inputs(0)=(InputName="P",Input=(Expression="/Script/Engine.MaterialExpressionWorldPosition'M_ExitClimate_EdgeFade:MaterialExpressionWorldPosition_0'",Mask=1,MaskR=1,MaskG=1,MaskB=1))
      Inputs(1)=(InputName="N",Input=(Expression="/Script/Engine.MaterialExpressionVertexNormalWS'M_ExitClimate_EdgeFade:MaterialExpressionVertexNormalWS_0'"))
      Inputs(2)=(InputName="Cold",Input=(Expression="/Script/Engine.MaterialExpressionCollectionParameter'M_ExitClimate_EdgeFade:MaterialExpressionCollectionParameter_0'"))
      MaterialExpressionGuid=8FB4DA7346F9FF82D432EE95EB87272F
      Material="/Script/Engine.Material'M_ExitClimate_EdgeFade'"
   End Object
   Begin Object Name="MaterialExpressionCustom_1" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/Art/Materials/ThroatEdgeFade/M_ExitClimate_EdgeFade.M_ExitClimate_EdgeFade:MaterialExpressionCustom_1'"
      Code="return lerp(Base,float3(.65,.82,.93),Frost*.84);"
      Description="Mouth climate frost color"
      Inputs(0)=(InputName="Base",Input=(Expression="/Script/Engine.MaterialExpressionLinearInterpolate'M_ExitClimate_EdgeFade:MaterialExpressionLinearInterpolate_1'"))
      Inputs(1)=(InputName="Frost",Input=(Expression="/Script/Engine.MaterialExpressionCustom'M_ExitClimate_EdgeFade:MaterialExpressionCustom_0'"))
      MaterialExpressionGuid=FA590CA04003D84C304C41AC34F8C633
      Material="/Script/Engine.Material'M_ExitClimate_EdgeFade'"
   End Object
   Begin Object Name="MaterialExpressionCustom_2" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/Art/Materials/ThroatEdgeFade/M_ExitClimate_EdgeFade.M_ExitClimate_EdgeFade:MaterialExpressionCustom_2'"
      Code="return lerp(Rough,.58,Frost);"
      OutputType=CMOT_Float1
      Description="Mouth climate rough crystalline finish"
      Inputs(0)=(InputName="Rough",Input=(Expression="/Script/Engine.MaterialExpressionMultiply'M_ExitClimate_EdgeFade:MaterialExpressionMultiply_13'"))
      Inputs(1)=(InputName="Frost",Input=(Expression="/Script/Engine.MaterialExpressionCustom'M_ExitClimate_EdgeFade:MaterialExpressionCustom_0'"))
      MaterialExpressionGuid=AE29513E4EA5CA45E378B8948BF3F251
      Material="/Script/Engine.Material'M_ExitClimate_EdgeFade'"
   End Object
   Begin Object Name="MaterialExpressionCustom_3" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/Art/Materials/ThroatEdgeFade/M_ExitClimate_EdgeFade.M_ExitClimate_EdgeFade:MaterialExpressionCustom_3'"
      Code="float d = saturate(Distance) * 200.0;\nfloat edge = smoothstep(0.0, clamp(Width, 0.01, 200.0), d);\nreturn lerp(1.0, edge, saturate(Amount));"
      OutputType=CMOT_Float1
      Description="Smooth transparency at the outer perimeter"
      Inputs(0)=(InputName="Distance",Input=(Expression="/Script/Engine.MaterialExpressionTextureSampleParameter2D'M_ExitClimate_EdgeFade:MaterialExpressionTextureSampleParameter2D_3'",OutputIndex=1,Mask=1,MaskR=1))
      Inputs(1)=(InputName="Width",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'M_ExitClimate_EdgeFade:MaterialExpressionScalarParameter_0'"))
      Inputs(2)=(InputName="Amount",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'M_ExitClimate_EdgeFade:MaterialExpressionScalarParameter_1'"))
      MaterialExpressionEditorX=-1800
      MaterialExpressionEditorY=3400
      MaterialExpressionGuid=F84D0F8441FC4494B19B238FAF77AF07
