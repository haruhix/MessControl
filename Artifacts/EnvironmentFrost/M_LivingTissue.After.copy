   Begin Object Name="MaterialExpressionCustom_0" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/Art/Materials/M_LivingTissue.M_LivingTissue:MaterialExpressionCustom_0'"
      Code="\nfloat grains=frac(sin(dot(floor(P*.9),float3(12.9898,78.233,45.164)))*43758.5453);\nfloat wisps=.5+.5*sin(P.x*.021+sin(P.y*.018)*2+P.z*.015);\nfloat coat=saturate(.38+.50*saturate(N.z)+.28*wisps+.12*grains);\nreturn saturate(Cold)*coat;\n"
      OutputType=CMOT_Float1
      Description="Mouth climate frost crystal coverage"
      Inputs(0)=(InputName="P",Input=(Expression="/Script/Engine.MaterialExpressionWorldPosition'M_LivingTissue:MaterialExpressionWorldPosition_0'",Mask=1,MaskR=1,MaskG=1,MaskB=1))
      Inputs(1)=(InputName="N",Input=(Expression="/Script/Engine.MaterialExpressionVertexNormalWS'M_LivingTissue:MaterialExpressionVertexNormalWS_0'"))
      Inputs(2)=(InputName="Cold",Input=(Expression="/Script/Engine.MaterialExpressionCollectionParameter'M_LivingTissue:MaterialExpressionCollectionParameter_0'"))
      MaterialExpressionGuid=BCE3578D413B125BD9EF46A8BEC6F7F7
      Material="/Script/Engine.Material'M_LivingTissue'"
   End Object
   Begin Object Name="MaterialExpressionCustom_1" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/Art/Materials/M_LivingTissue.M_LivingTissue:MaterialExpressionCustom_1'"
      Code="return lerp(Base,float3(.65,.82,.93),Frost*.84);"
      Description="Mouth climate frost color"
      Inputs(0)=(InputName="Base",Input=(Expression="/Script/Engine.MaterialExpressionCustom'M_LivingTissue:MaterialExpressionCustom_8'"))
      Inputs(1)=(InputName="Frost",Input=(Expression="/Script/Engine.MaterialExpressionCustom'M_LivingTissue:MaterialExpressionCustom_0'"))
      MaterialExpressionGuid=09F9E3064619D583B7622399D1E87142
      Material="/Script/Engine.Material'M_LivingTissue'"
   End Object
   Begin Object Name="MaterialExpressionCustom_10" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/Art/Materials/M_LivingTissue.M_LivingTissue:MaterialExpressionCustom_10'"
      Code="return normalize(float3(N.xy*Strength,N.z));"
      Description="Gentle normal"
      Inputs(0)=(InputName="N",Input=(Expression="/Script/Engine.MaterialExpressionTextureSampleParameter2D'M_LivingTissue:MaterialExpressionTextureSampleParameter2D_8'",Mask=1,MaskR=1,MaskG=1,MaskB=1))
      Inputs(1)=(InputName="Strength",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'M_LivingTissue:MaterialExpressionScalarParameter_10'"))
      MaterialExpressionEditorX=100
      MaterialExpressionEditorY=1020
      MaterialExpressionGuid=0FF894184089776558C9DFBF871E3EFD
      Material="/Script/Engine.Material'M_LivingTissue'"
   End Object
   Begin Object Name="MaterialExpressionCustom_11" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/Art/Materials/M_LivingTissue.M_LivingTissue:MaterialExpressionCustom_11'"
      Code="return Base.rgb*float3(.8,.30,.40);"
      Description="Soft red scatter"
      Inputs(0)=(InputName="Base",Input=(Expression="/Script/Engine.MaterialExpressionCustom'M_LivingTissue:MaterialExpressionCustom_8'"))
      MaterialExpressionEditorX=100
      MaterialExpressionEditorY=1105
      MaterialExpressionGuid=81C662F048CB0ED9075436830F47B97C
      Material="/Script/Engine.Material'M_LivingTissue'"
   End Object
   Begin Object Name="MaterialExpressionCustom_2" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/Art/Materials/M_LivingTissue.M_LivingTissue:MaterialExpressionCustom_2'"
      Code="return lerp(Rough,.58,Frost);"
      OutputType=CMOT_Float1
      Description="Mouth climate rough crystalline finish"
      Inputs(0)=(InputName="Rough",Input=(Expression="/Script/Engine.MaterialExpressionCustom'M_LivingTissue:MaterialExpressionCustom_9'"))
      Inputs(1)=(InputName="Frost",Input=(Expression="/Script/Engine.MaterialExpressionCustom'M_LivingTissue:MaterialExpressionCustom_0'"))
      MaterialExpressionGuid=8CA4B7B54E571815BFF4DBB58DCD957A
      Material="/Script/Engine.Material'M_LivingTissue'"
   End Object
   Begin Object Name="MaterialExpressionCustom_3" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/Art/Materials/M_LivingTissue.M_LivingTissue:MaterialExpressionCustom_3'"
      Code="\nfloat3 q=P*.075;\nfloat a=q.x+1.8*sin(q.y*.81)+.8*sin(q.z*.57);\nfloat b=q.y+1.6*sin(q.z*.92)+.6*sin(q.x*.73);\nfloat c=q.z+1.4*sin(q.x*.84)+.8*sin(q.y*.67);\nfloat3 g=float3(cos(a),cos(b),cos(c));\nfloat3 pores=sin(P.yzx*.57+sin(P.xyz*.29)*2.1);\nfloat3 grain=g+pores*.23;\nfloat3 nn=normalize(N); grain-=nn*dot(grain,nn);\nreturn normalize(nn-grain*Strength);\n"
      Description="V4 mucosa fine creases"
      Inputs(0)=(InputName="P",Input=(Expression="/Script/Engine.MaterialExpressionWorldPosition'M_LivingTissue:MaterialExpressionWorldPosition_1'",Mask=1,MaskR=1,MaskG=1,MaskB=1))
      Inputs(1)=(InputName="N",Input=(Expression="/Script/Engine.MaterialExpressionTransform'M_LivingTissue:MaterialExpressionTransform_0'"))
      Inputs(2)=(InputName="Strength",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'M_LivingTissue:MaterialExpressionScalarParameter_0'"))
      MaterialExpressionGuid=025C699848EB1405631F7EB0441E7754
      Material="/Script/Engine.Material'M_LivingTissue'"
   End Object
   Begin Object Name="MaterialExpressionCustom_8" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/Art/Materials/M_LivingTissue.M_LivingTissue:MaterialExpressionCustom_8'"
      Code="float n=sin(P.x*.011+sin(P.y*.019))*sin(P.z*.016+P.y*.008); return Base.rgb*Tint.rgb*(.98+.04*n);"
      Description="Subtle vascular mottling"
      Inputs(0)=(InputName="P",Input=(Expression="/Script/Engine.MaterialExpressionWorldPosition'M_LivingTissue:MaterialExpressionWorldPosition_2'",Mask=1,MaskR=1,MaskG=1,MaskB=1))
      Inputs(1)=(InputName="Base",Input=(Expression="/Script/Engine.MaterialExpressionTextureSampleParameter2D'M_LivingTissue:MaterialExpressionTextureSampleParameter2D_7'",Mask=1,MaskR=1,MaskG=1,MaskB=1))
      Inputs(2)=(InputName="Tint",Input=(Expression="/Script/Engine.MaterialExpressionVectorParameter'M_LivingTissue:MaterialExpressionVectorParameter_2'",OutputIndex=5,Mask=1,MaskR=1,MaskG=1,MaskB=1,MaskA=1))
      MaterialExpressionEditorX=100
      MaterialExpressionEditorY=595
      MaterialExpressionGuid=BA66B45C4FC1ED2F41AE319657B3BBDC
      Material="/Script/Engine.Material'M_LivingTissue'"
   End Object
   Begin Object Name="MaterialExpressionCustom_9" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/Art/Materials/M_LivingTissue.M_LivingTissue:MaterialExpressionCustom_9'"
      Code="return clamp(.14+ORM.g*.18+Bias*.15,.17,.28);"
      OutputType=CMOT_Float1
      Description="Wet film"
      Inputs(0)=(InputName="ORM",Input=(Expression="/Script/Engine.MaterialExpressionTextureSampleParameter2D'M_LivingTissue:MaterialExpressionTextureSampleParameter2D_9'",Mask=1,MaskR=1,MaskG=1,MaskB=1))
