   Begin Object Name="MaterialExpressionCustom_8" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/Gameplay/Care/M_ArenaToothRelief.M_ArenaToothRelief:MaterialExpressionCustom_8'"
      Code="\nfloat3 n=normalize(N);\n// The mesh supplies the silhouette; these centimetre-scale derivatives add\n// built-up body, tapered edges and actual pits without moving contact geometry.\nfloat coverage=saturate(F.x);\nfloat h=coverage*(.10+.64*smoothstep(.12,.92,F.z)+D.w*max(Strength,0));\nfloat3 dx=ddx(World),dy=ddy(World),rx=cross(dy,n),ry=cross(n,dx);\nfloat det=dot(dx,rx);\n// Map the rest-space normal slopes through current surface derivatives. This\n// remains attached under rotation and pose instead of treating them as world XY.\nfloat sx=ddx(h)+coverage*max(NormalStrength,0)*dot(Slope,ddx(P*Scale));\nfloat sy=ddy(h)+coverage*max(NormalStrength,0)*dot(Slope,ddy(P*Scale));\nreturn normalize(n-(sx*rx+sy*ry)*sign(det)/max(abs(det),1e-5));\n"
      Description="MC Care: meniscusNormal"
      Inputs(0)=(InputName="World",Input=(Expression="/Script/Engine.MaterialExpressionWorldPosition'M_ArenaToothRelief:MaterialExpressionWorldPosition_0'",Mask=1,MaskR=1,MaskG=1,MaskB=1))
      Inputs(1)=(InputName="N",Input=(Expression="/Script/Engine.MaterialExpressionVertexInterpolator'M_ArenaToothRelief:MaterialExpressionVertexInterpolator_4'"))
      Inputs(2)=(InputName="F",Input=(Expression="/Script/Engine.MaterialExpressionCustom'M_ArenaToothRelief:MaterialExpressionCustom_4'"))
      Inputs(3)=(InputName="D",Input=(Expression="/Script/Engine.MaterialExpressionCustom'M_ArenaToothRelief:MaterialExpressionCustom_0'"))
      Inputs(4)=(InputName="Strength",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'M_ArenaToothRelief:MaterialExpressionScalarParameter_2'"))
      Inputs(5)=(InputName="Slope",Input=(Expression="/Script/Engine.MaterialExpressionCustom'M_ArenaToothRelief:MaterialExpressionCustom_2'"))
      Inputs(6)=(InputName="P",Input=(Expression="/Script/Engine.MaterialExpressionVertexInterpolator'M_ArenaToothRelief:MaterialExpressionVertexInterpolator_2'"))
      Inputs(7)=(InputName="Scale",Input=(Expression="/Script/Engine.MaterialExpressionVectorParameter'M_ArenaToothRelief:MaterialExpressionVectorParameter_7'",Mask=1,MaskR=1,MaskG=1,MaskB=1))
      Inputs(8)=(InputName="NormalStrength",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'M_ArenaToothRelief:MaterialExpressionScalarParameter_6'"))
      MaterialExpressionEditorX=860
      MaterialExpressionEditorY=1360
      MaterialExpressionGuid=AD388CD845585FF7ECD5DF9A765F6458
      Material="/Script/Engine.Material'M_ArenaToothRelief'"
   End Object
   Begin Object Name="MaterialExpressionCustom_7" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/Gameplay/Care/M_ArenaToothRelief.M_ArenaToothRelief:MaterialExpressionCustom_7'"
      Code="\nfloat edge=max(fwidth(F.x)*1.25,.025);\nreturn smoothstep(.25-edge,.25+edge,F.x);\n"
      OutputType=CMOT_Float1
      Description="MC Care: coatingClip"
      Inputs(0)=(InputName="F",Input=(Expression="/Script/Engine.MaterialExpressionCustom'M_ArenaToothRelief:MaterialExpressionCustom_4'"))
      MaterialExpressionEditorX=860
      MaterialExpressionEditorY=1120
      MaterialExpressionGuid=A89281FC485B82FBA02EC8B02F633FB9
      Material="/Script/Engine.Material'M_ArenaToothRelief'"
   End Object
   Begin Object Name="MaterialExpressionCustom_6" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/Gameplay/Care/M_ArenaToothRelief.M_ArenaToothRelief:MaterialExpressionCustom_6'"
      Code="\nfloat margin=1-smoothstep(.18,.56,F.x);\nfloat rough=lerp(.33,.83,D.z)+(1-D.y)*.06;\nrough=lerp(rough,.17,margin*.84);\nreturn lerp(rough,.43,F.y);\n"
      OutputType=CMOT_Float1
      Description="MC Care: coatingRoughness"
      Inputs(0)=(InputName="F",Input=(Expression="/Script/Engine.MaterialExpressionCustom'M_ArenaToothRelief:MaterialExpressionCustom_4'"))
      Inputs(1)=(InputName="D",Input=(Expression="/Script/Engine.MaterialExpressionCustom'M_ArenaToothRelief:MaterialExpressionCustom_0'"))
      MaterialExpressionEditorX=430
      MaterialExpressionEditorY=1120
      MaterialExpressionGuid=417B7DB64D7D818D15C135A7A7F24017
      Material="/Script/Engine.Material'M_ArenaToothRelief'"
   End Object
   Begin Object Name="MaterialExpressionCustom_5" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/Gameplay/Care/M_ArenaToothRelief.M_ArenaToothRelief:MaterialExpressionCustom_5'"
      Code="\nfloat body=saturate(F.z*.62+(1-D.x)*.28+F.w*.10);\nfloat3 color=lerp(lerp(Light,Dark,smoothstep(.06,.83,body)),Pigment,.72);\ncolor*=lerp(.54,1.22,smoothstep(.08,.92,D.x))*D.y;\nfloat margin=1-smoothstep(.18,.56,F.x);\ncolor=lerp(color,Rim,margin*.38);\nreturn lerp(color,float3(.92,.97,.94),F.y*.96);\n"
      Description="MC Care: coatingColor"
      Inputs(0)=(InputName="P",Input=(Expression="/Script/Engine.MaterialExpressionVertexInterpolator'M_ArenaToothRelief:MaterialExpressionVertexInterpolator_2'"))
      Inputs(1)=(InputName="N",Input=(Expression="/Script/Engine.MaterialExpressionVertexInterpolator'M_ArenaToothRelief:MaterialExpressionVertexInterpolator_3'"))
      Inputs(2)=(InputName="Tex",Input=(Expression="/Script/Engine.MaterialExpressionTextureObjectParameter'M_ArenaToothRelief:MaterialExpressionTextureObjectParameter_3'"))
      Inputs(3)=(InputName="Tint",Input=(Expression="/Script/Engine.MaterialExpressionVectorParameter'M_ArenaToothRelief:MaterialExpressionVectorParameter_9'",Mask=1,MaskR=1,MaskG=1,MaskB=1))
      Inputs(4)=(InputName="F",Input=(Expression="/Script/Engine.MaterialExpressionCustom'M_ArenaToothRelief:MaterialExpressionCustom_4'"))
      Inputs(5)=(InputName="D",Input=(Expression="/Script/Engine.MaterialExpressionCustom'M_ArenaToothRelief:MaterialExpressionCustom_0'"))
      Inputs(6)=(InputName="Light",Input=(Expression="/Script/Engine.MaterialExpressionVectorParameter'M_ArenaToothRelief:MaterialExpressionVectorParameter_0'",Mask=1,MaskR=1,MaskG=1,MaskB=1))
      Inputs(7)=(InputName="Dark",Input=(Expression="/Script/Engine.MaterialExpressionVectorParameter'M_ArenaToothRelief:MaterialExpressionVectorParameter_1'",Mask=1,MaskR=1,MaskG=1,MaskB=1))
      Inputs(8)=(InputName="Rim",Input=(Expression="/Script/Engine.MaterialExpressionVectorParameter'M_ArenaToothRelief:MaterialExpressionVectorParameter_2'",Mask=1,MaskR=1,MaskG=1,MaskB=1))
      Inputs(9)=(InputName="Pigment",Input=(Expression="/Script/Engine.MaterialExpressionCustom'M_ArenaToothRelief:MaterialExpressionCustom_1'"))
      MaterialExpressionEditorY=1120
      MaterialExpressionGuid=8ABADCC247F4B984FC0816A61A88745A
      Material="/Script/Engine.Material'M_ArenaToothRelief'"
   End Object
   Begin Object Name="MaterialExpressionCustom_4" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/Gameplay/Care/M_ArenaToothRelief.M_ArenaToothRelief:MaterialExpressionCustom_4'"
      Code="float3 uv=saturate((P-Minimum)/max(Size,.01))*15;\nfloat z0=floor(uv.z),z1=min(z0+1,15);\nfloat2 a=(uv.xy+float2(fmod(z0,4),floor(z0/4))*16+.5)/64;\nfloat2 b=(uv.xy+float2(fmod(z1,4),floor(z1/4))*16+.5)/64;\nfloat wipe=lerp(Texture2DSampleLevel(Wipe,WipeSampler,a,0).r,Texture2DSampleLevel(Wipe,WipeSampler,b,0).r,frac(uv.z));\nfloat foam=(1-smoothstep(23,45,length((P-Brush)*Scale)))*(1-smoothstep(.25,1.4,Age));\nreturn float4(V.r*wipe*saturate(Amount*2),foam,V.b,V.g);\n"
      OutputType=CMOT_Float4
      Description="MC Care: coatingMask"
      Inputs(0)=(InputName="P",Input=(Expression="/Script/Engine.MaterialExpressionVertexInterpolator'M_ArenaToothRelief:MaterialExpressionVertexInterpolator_2'"))
      Inputs(1)=(InputName="V",Input=(Expression="/Script/Engine.MaterialExpressionVertexColor'M_ArenaToothRelief:MaterialExpressionVertexColor_1'",Mask=1,MaskR=1,MaskG=1,MaskB=1))
      Inputs(2)=(InputName="Minimum",Input=(Expression="/Script/Engine.MaterialExpressionVectorParameter'M_ArenaToothRelief:MaterialExpressionVectorParameter_5'",Mask=1,MaskR=1,MaskG=1,MaskB=1))
      Inputs(3)=(InputName="Size",Input=(Expression="/Script/Engine.MaterialExpressionVectorParameter'M_ArenaToothRelief:MaterialExpressionVectorParameter_6'",Mask=1,MaskR=1,MaskG=1,MaskB=1))
      Inputs(4)=(InputName="Scale",Input=(Expression="/Script/Engine.MaterialExpressionVectorParameter'M_ArenaToothRelief:MaterialExpressionVectorParameter_7'",Mask=1,MaskR=1,MaskG=1,MaskB=1))
      Inputs(5)=(InputName="Wipe",Input=(Expression="/Script/Engine.MaterialExpressionTextureObjectParameter'M_ArenaToothRelief:MaterialExpressionTextureObjectParameter_2'"))
      Inputs(6)=(InputName="Amount",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'M_ArenaToothRelief:MaterialExpressionScalarParameter_3'"))
      Inputs(7)=(InputName="Age",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'M_ArenaToothRelief:MaterialExpressionScalarParameter_4'"))
      Inputs(8)=(InputName="Brush",Input=(Expression="/Script/Engine.MaterialExpressionVectorParameter'M_ArenaToothRelief:MaterialExpressionVectorParameter_8'",Mask=1,MaskR=1,MaskG=1,MaskB=1))
      MaterialExpressionEditorX=1720
      MaterialExpressionEditorY=880
      MaterialExpressionGuid=AE482E3A46BADEAB6617B0A8BE507304
      Material="/Script/Engine.Material'M_ArenaToothRelief'"
   End Object
   Begin Object Name="MaterialExpressionCustom_2" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/Gameplay/Care/M_ArenaToothRelief.M_ArenaToothRelief:MaterialExpressionCustom_2'"
      Code="\n[branch] if (Amount<=.0001) return float3(0,0,0);\nfloat3 q=P*Scale/max(Tile,8.0)+Seed*float3(.37,.19,.73);\nfloat3 w=abs(normalize(N)); w*=w; w*=w; w/=max(dot(w,1),.0001);\n// BC5 normal textures store signed tangent X/Y in their two sampled channels.\n// Reconstruct Z, then express the three projection slopes in rest-space cm.\nfloat2 x=Texture2DSample(NormalMap,NormalMapSampler,q.yz).rg*2-1;\nfloat2 y=Texture2DSample(NormalMap,NormalMapSampler,q.xz).rg*2-1;\nfloat2 z=Texture2DSample(NormalMap,NormalMapSampler,q.xy).rg*2-1;\nx/=-max(sqrt(saturate(1-dot(x,x))),.35);\ny/=-max(sqrt(saturate(1-dot(y,y))),.35);\nz/=-max(sqrt(saturate(1-dot(z,z))),.35);\nreturn float3(0,x.x,x.y)*w.x+float3(y.x,0,y.y)*w.y+float3(z.x,z.y,0)*w.z;\n"
      Description="MC Care: anchored plaque detail normal slope"
      Inputs(0)=(InputName="P",Input=(Expression="/Script/Engine.MaterialExpressionVertexInterpolator'M_ArenaToothRelief:MaterialExpressionVertexInterpolator_2'"))
      Inputs(1)=(InputName="N",Input=(Expression="/Script/Engine.MaterialExpressionVertexInterpolator'M_ArenaToothRelief:MaterialExpressionVertexInterpolator_3'"))
      Inputs(2)=(InputName="Scale",Input=(Expression="/Script/Engine.MaterialExpressionVectorParameter'M_ArenaToothRelief:MaterialExpressionVectorParameter_7'",Mask=1,MaskR=1,MaskG=1,MaskB=1))
      Inputs(3)=(InputName="Tile",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'M_ArenaToothRelief:MaterialExpressionScalarParameter_0'"))
      Inputs(4)=(InputName="Seed",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'M_ArenaToothRelief:MaterialExpressionScalarParameter_1'"))
      Inputs(5)=(InputName="Amount",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'M_ArenaToothRelief:MaterialExpressionScalarParameter_3'"))
      Inputs(6)=(InputName="NormalMap",Input=(Expression="/Script/Engine.MaterialExpressionTextureObjectParameter'M_ArenaToothRelief:MaterialExpressionTextureObjectParameter_4'"))
      MaterialExpressionEditorX=1600
      MaterialExpressionEditorY=4800
      MaterialExpressionGuid=B1AB04714B1DB121BD514497D4B94C80
      Material="/Script/Engine.Material'M_ArenaToothRelief'"
   End Object
   Begin Object Name="MaterialExpressionCustom_1" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/Gameplay/Care/M_ArenaToothRelief.M_ArenaToothRelief:MaterialExpressionCustom_1'"
      Code="\n[branch] if (Amount<=.0001) return float3(.2,.08,.018);\nfloat3 q=P*Scale/max(Tile,8.0)+Seed*float3(.37,.19,.73);\nfloat3 w=abs(normalize(N)); w*=w; w*=w; w/=max(dot(w,1),.0001);\nreturn Texture2DSample(Pigment,PigmentSampler,q.yz).rgb*w.x\n      +Texture2DSample(Pigment,PigmentSampler,q.xz).rgb*w.y\n      +Texture2DSample(Pigment,PigmentSampler,q.xy).rgb*w.z;\n"
      Description="MC Care: anchored plaque detail pigment"
      Inputs(0)=(InputName="P",Input=(Expression="/Script/Engine.MaterialExpressionVertexInterpolator'M_ArenaToothRelief:MaterialExpressionVertexInterpolator_2'"))
      Inputs(1)=(InputName="N",Input=(Expression="/Script/Engine.MaterialExpressionVertexInterpolator'M_ArenaToothRelief:MaterialExpressionVertexInterpolator_3'"))
      Inputs(2)=(InputName="Scale",Input=(Expression="/Script/Engine.MaterialExpressionVectorParameter'M_ArenaToothRelief:MaterialExpressionVectorParameter_7'",Mask=1,MaskR=1,MaskG=1,MaskB=1))
      Inputs(3)=(InputName="Tile",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'M_ArenaToothRelief:MaterialExpressionScalarParameter_0'"))
      Inputs(4)=(InputName="Seed",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'M_ArenaToothRelief:MaterialExpressionScalarParameter_1'"))
      Inputs(5)=(InputName="Amount",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'M_ArenaToothRelief:MaterialExpressionScalarParameter_3'"))
      Inputs(6)=(InputName="Pigment",Input=(Expression="/Script/Engine.MaterialExpressionTextureObjectParameter'M_ArenaToothRelief:MaterialExpressionTextureObjectParameter_3'"))
      MaterialExpressionEditorX=1600
      MaterialExpressionEditorY=4600
      MaterialExpressionGuid=6DB5AC7848B00CE3EF9CCE98EF384AF7
      Material="/Script/Engine.Material'M_ArenaToothRelief'"
   End Object
   Begin Object Name="MaterialExpressionCustom_0" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/Gameplay/Care/M_ArenaToothRelief.M_ArenaToothRelief:MaterialExpressionCustom_0'"
      Code="\n[branch] if (Amount<=.0001) return float4(.5,1,.5,0);\n// Coordinates follow the surface, including piano movement and skeletal pose.\nfloat3 q=P*Scale/max(Tile,8.0)+Seed*float3(.37,.19,.73);\nfloat3 w=abs(normalize(N)); w*=w; w*=w; w/=max(dot(w,1),.0001);\nfloat h=Texture2DSample(Height,HeightSampler,q.yz).r*w.x\n       +Texture2DSample(Height,HeightSampler,q.xz).r*w.y\n       +Texture2DSample(Height,HeightSampler,q.xy).r*w.z;\nfloat rough=Texture2DSample(Surface,SurfaceSampler,q.yz).r*w.x\n           +Texture2DSample(Surface,SurfaceSampler,q.xz).r*w.y\n           +Texture2DSample(Surface,SurfaceSampler,q.xy).r*w.z;\n// Height is independent of albedo: pits, granules and built-up plateaus remain\n// visible under moving lights rather than collapsing to one saturated brown.\nfloat plateau=smoothstep(.24,.78,h);\nfloat pit=1-smoothstep(.13,.43,h);\nfloat relief=(h-.5)*.72+plateau*.28-pit*.13;\nreturn float4(h,1-pit*.52,saturate(rough),relief);\n"
      OutputType=CMOT_Float4
      Description="MC Care: anchored plaque detail"
      Inputs(0)=(InputName="P",Input=(Expression="/Script/Engine.MaterialExpressionVertexInterpolator'M_ArenaToothRelief:MaterialExpressionVertexInterpolator_2'"))
      Inputs(1)=(InputName="N",Input=(Expression="/Script/Engine.MaterialExpressionVertexInterpolator'M_ArenaToothRelief:MaterialExpressionVertexInterpolator_3'"))
      Inputs(2)=(InputName="Scale",Input=(Expression="/Script/Engine.MaterialExpressionVectorParameter'M_ArenaToothRelief:MaterialExpressionVectorParameter_7'",Mask=1,MaskR=1,MaskG=1,MaskB=1))
      Inputs(3)=(InputName="Tile",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'M_ArenaToothRelief:MaterialExpressionScalarParameter_0'"))
      Inputs(4)=(InputName="Seed",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'M_ArenaToothRelief:MaterialExpressionScalarParameter_1'"))
      Inputs(5)=(InputName="Pigment",Input=(Expression="/Script/Engine.MaterialExpressionTextureObjectParameter'M_ArenaToothRelief:MaterialExpressionTextureObjectParameter_3'"))
      Inputs(6)=(InputName="Surface",Input=(Expression="/Script/Engine.MaterialExpressionTextureObjectParameter'M_ArenaToothRelief:MaterialExpressionTextureObjectParameter_0'"))
      Inputs(7)=(InputName="Amount",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'M_ArenaToothRelief:MaterialExpressionScalarParameter_3'"))
      Inputs(8)=(InputName="Height",Input=(Expression="/Script/Engine.MaterialExpressionTextureObjectParameter'M_ArenaToothRelief:MaterialExpressionTextureObjectParameter_1'"))
      MaterialExpressionEditorX=1600
      MaterialExpressionEditorY=4400
      MaterialExpressionGuid=BE995D3E4FE9CE1B49ADCEB1FA5C215D
      Material="/Script/Engine.Material'M_ArenaToothRelief'"
   End Object
