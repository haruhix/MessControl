      FunctionInputs(0)=(ExpressionInputId=982BCAE7401F814CDC0AE2955DEE46F3,Input=(Expression="/Script/Engine.MaterialExpressionCustom'M_ArenaToothRelief:MaterialExpressionCustom_7'",InputName="Alpha Threshold"))
