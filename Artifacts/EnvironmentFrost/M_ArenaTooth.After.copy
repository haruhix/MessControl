   Begin Object Name="MaterialExpressionCustom_1" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/Art/Materials/M_ArenaTooth.M_ArenaTooth:MaterialExpressionCustom_1'"
      Code="\nfloat waves = sin(P.y*.16 + sin(P.z*.09)*1.8) + sin(P.x*.18 + P.z*.115) + .55*cos(P.z*.26-P.y*.11);\nfloat patch = smoothstep(.05,.35,waves) * Coffee;\nfloat3 base = lerp(Enamel,Stain*(.8+.2*sin(P.z*.3)),patch);\nfloat crack = 1-smoothstep(.025,.075,abs(sin(P.z*.13+P.y*.085+sin(P.y*.16)*.8)));\ncrack *= smoothstep(.15,.65,Damage) * smoothstep(25,65,P.z);\nbase = lerp(base, float3(.075,.024,.012), crack*.85);\nbase = lerp(base,float3(1,.3,.08),Flash*.55);\nreturn base;\n"
      Description="Enamel + surface coffee + damage cracks"
      Inputs(0)=(InputName="P",Input=(Expression="/Script/Engine.MaterialExpressionVertexInterpolator'M_ArenaTooth:MaterialExpressionVertexInterpolator_0'"))
      Inputs(1)=(InputName="Coffee",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'M_ArenaTooth:MaterialExpressionScalarParameter_4'"))
      Inputs(2)=(InputName="Damage",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'M_ArenaTooth:MaterialExpressionScalarParameter_5'"))
      Inputs(3)=(InputName="Flash",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'M_ArenaTooth:MaterialExpressionScalarParameter_6'"))
      Inputs(4)=(InputName="Enamel",Input=(Expression="/Script/Engine.MaterialExpressionVectorParameter'M_ArenaTooth:MaterialExpressionVectorParameter_2'",Mask=1,MaskR=1,MaskG=1,MaskB=1))
      Inputs(5)=(InputName="Stain",Input=(Expression="/Script/Engine.MaterialExpressionVectorParameter'M_ArenaTooth:MaterialExpressionVectorParameter_3'",Mask=1,MaskR=1,MaskG=1,MaskB=1))
      MaterialExpressionEditorX=-100
      MaterialExpressionGuid=4A23B13D45F68A0B79A62F919FFF0399
      Material="/Script/Engine.Material'M_ArenaTooth'"
   End Object
