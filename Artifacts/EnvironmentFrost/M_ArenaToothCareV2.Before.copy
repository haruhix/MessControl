   Begin Object Name="MaterialExpressionCustom_8" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/Gameplay/Arena/V2/M_ArenaToothCareV2.M_ArenaToothCareV2:MaterialExpressionCustom_8'"
      Code="return lerp(Rough,.58,Frost);"
      OutputType=CMOT_Float1
      Description="Mouth climate rough crystalline finish"
      Inputs(0)=(InputName="Rough",Input=(Expression="/Script/Engine.MaterialExpressionCustom'M_ArenaToothCareV2:MaterialExpressionCustom_3'"))
      Inputs(1)=(InputName="Frost",Input=(Expression="/Script/Engine.MaterialExpressionCustom'M_ArenaToothCareV2:MaterialExpressionCustom_6'"))
      MaterialExpressionGuid=0122E2CD41A05CF7540CAAAEA9DDADF3
