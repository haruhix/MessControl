   End Object
   Begin Object Name="MaterialExpressionCustom_7" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/Gameplay/Arena/V2/M_ArenaToothCareV2.M_ArenaToothCareV2:MaterialExpressionCustom_7'"
      Code="return lerp(Base,float3(.65,.82,.93),Frost*.84);"
      Description="Mouth climate frost color"
      Inputs(0)=(InputName="Base",Input=(Expression="/Script/Engine.MaterialExpressionCustom'M_ArenaToothCareV2:MaterialExpressionCustom_2'"))
      Inputs(1)=(InputName="Frost",Input=(Expression="/Script/Engine.MaterialExpressionCustom'M_ArenaToothCareV2:MaterialExpressionCustom_6'"))
      MaterialExpressionGuid=D4CECB6546A9CFDF7401ADA8D1072844
      Material="/Script/Engine.Material'M_ArenaToothCareV2'"
   End Object
   Begin Object Name="MaterialExpressionCustom_6" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/Gameplay/Arena/V2/M_ArenaToothCareV2.M_ArenaToothCareV2:MaterialExpressionCustom_6'"
      Code="\nfloat grains=frac(sin(dot(floor(P*.9),float3(12.9898,78.233,45.164)))*43758.5453);\nfloat wisps=.5+.5*sin(P.x*.021+sin(P.y*.018)*2+P.z*.015);\nfloat coat=saturate(.38+.50*saturate(N.z)+.28*wisps+.12*grains);\nreturn saturate(Cold)*coat;\n"
      OutputType=CMOT_Float1
      Description="Mouth climate frost crystal coverage"
      Inputs(0)=(InputName="P",Input=(Expression="/Script/Engine.MaterialExpressionWorldPosition'M_ArenaToothCareV2:MaterialExpressionWorldPosition_1'",Mask=1,MaskR=1,MaskG=1,MaskB=1))
      Inputs(1)=(InputName="N",Input=(Expression="/Script/Engine.MaterialExpressionVertexNormalWS'M_ArenaToothCareV2:MaterialExpressionVertexNormalWS_1'"))
      Inputs(2)=(InputName="Cold",Input=(Expression="/Script/Engine.MaterialExpressionCollectionParameter'M_ArenaToothCareV2:MaterialExpressionCollectionParameter_0'"))
      MaterialExpressionGuid=CF2A540C4BF23E63AD365CB9EA2CD867
      Material="/Script/Engine.Material'M_ArenaToothCareV2'"
   End Object
   Begin Object Name="MaterialExpressionCustom_5" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/Gameplay/Arena/V2/M_ArenaToothCareV2.M_ArenaToothCareV2:MaterialExpressionCustom_5'"
      Code="\nfloat3 n=normalize(N);\nfloat3 dx=ddx(World),dy=ddy(World);\nfloat3 rx=cross(dy,n),ry=cross(n,dx);\nfloat det=dot(dx,rx);\nfloat3 slope=(ddx(Height)*rx+ddy(Height)*ry)*sign(det)/max(abs(det),1e-5);\nreturn normalize(n-slope);\n"
      Description="MC Care: filmNormal"
      Inputs(0)=(InputName="World",Input=(Expression="/Script/Engine.MaterialExpressionWorldPosition'M_ArenaToothCareV2:MaterialExpressionWorldPosition_0'",Mask=1,MaskR=1,MaskG=1,MaskB=1))
      Inputs(1)=(InputName="N",Input=(Expression="/Script/Engine.MaterialExpressionTransform'M_ArenaToothCareV2:MaterialExpressionTransform_0'"))
      Inputs(2)=(InputName="Height",Input=(Expression="/Script/Engine.MaterialExpressionCustom'M_ArenaToothCareV2:MaterialExpressionCustom_4'"))
      MaterialExpressionEditorX=430
      MaterialExpressionEditorY=1600
      MaterialExpressionGuid=735B34E746EE097E8558A2A473C3AAC9
      Material="/Script/Engine.Material'M_ArenaToothCareV2'"
   End Object
   Begin Object Name="MaterialExpressionCustom_4" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/Gameplay/Arena/V2/M_ArenaToothCareV2.M_ArenaToothCareV2:MaterialExpressionCustom_4'"
      Code="\nstruct Noise {\n float hash(float3 p) { return frac(sin(dot(p,float3(127.1,311.7,74.7)))*43758.5453); }\n float value(float3 p) {\n  float3 i=floor(p), f=frac(p); f=f*f*(3-2*f);\n  return lerp(lerp(lerp(hash(i),hash(i+float3(1,0,0)),f.x),lerp(hash(i+float3(0,1,0)),hash(i+float3(1,1,0)),f.x),f.y),\n              lerp(lerp(hash(i+float3(0,0,1)),hash(i+float3(1,0,1)),f.x),lerp(hash(i+float3(0,1,1)),hash(i+1),f.x),f.y),f.z);\n }\n}; Noise S;\n\nfloat bead=smoothstep(.39,.67,S.value(P*.18+Seed));\nfloat broad=smoothstep(.30,.68,S.value(P*.060+Seed*2.7));\nreturn pow(saturate(F.x),.62)*Thickness*(.25+.30*broad+1.10*bead)+F.y*.35;\n"
      OutputType=CMOT_Float1
      Description="MC Care: filmHeight"
      Inputs(0)=(InputName="P",Input=(Expression="/Script/Engine.MaterialExpressionVertexInterpolator'M_ArenaToothCareV2:MaterialExpressionVertexInterpolator_0'"))
      Inputs(1)=(InputName="F",Input=(Expression="/Script/Engine.MaterialExpressionCustom'M_ArenaToothCareV2:MaterialExpressionCustom_1'"))
      Inputs(2)=(InputName="Seed",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'M_ArenaToothCareV2:MaterialExpressionScalarParameter_3'"))
      Inputs(3)=(InputName="Thickness",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'M_ArenaToothCareV2:MaterialExpressionScalarParameter_4'"))
      MaterialExpressionEditorY=1600
      MaterialExpressionGuid=4DDFA1AD4EA9A383498A76A4C93C4AD8
      Material="/Script/Engine.Material'M_ArenaToothCareV2'"
   End Object
   Begin Object Name="MaterialExpressionCustom_3" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/Gameplay/Arena/V2/M_ArenaToothCareV2.M_ArenaToothCareV2:MaterialExpressionCustom_3'"
      Code="return lerp(lerp(.18,.135,F.z*.6),.38,F.y);"
      OutputType=CMOT_Float1
      Description="MC Care: cleaningRoughness"
      Inputs(0)=(InputName="Base",Input=(Expression="/Script/Engine.MaterialExpressionTextureSampleParameter2D'M_ArenaToothCareV2:MaterialExpressionTextureSampleParameter2D_1'",OutputIndex=2,Mask=1,MaskG=1))
      Inputs(1)=(InputName="F",Input=(Expression="/Script/Engine.MaterialExpressionCustom'M_ArenaToothCareV2:MaterialExpressionCustom_1'"))
      MaterialExpressionEditorX=1290
      MaterialExpressionEditorY=1360
      MaterialExpressionGuid=D3A27D704C1263F587EA79B98BD476CF
      Material="/Script/Engine.Material'M_ArenaToothCareV2'"
   End Object
   Begin Object Name="MaterialExpressionCustom_2" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/Gameplay/Arena/V2/M_ArenaToothCareV2.M_ArenaToothCareV2:MaterialExpressionCustom_2'"
      Code="\nfloat3 cream=float3(.91,.79,.62)*lerp(.96,1.04,saturate(Enamel.r));\nfloat3 pigment=Tint*lerp(.7,1.5,saturate(Pigment.r*2.5));\nfloat3 color=lerp(cream,pigment,F.x);\ncolor=lerp(color,float3(.075,.024,.012),F.w*.85);\ncolor=lerp(color,float3(.91,.98,.95),F.y*.95);\nreturn lerp(color,float3(1,.3,.08),saturate(Flash)*.55);\n"
      Description="MC Care: cleaningColor"
      Inputs(0)=(InputName="Enamel",Input=(Expression="/Script/Engine.MaterialExpressionTextureSampleParameter2D'M_ArenaToothCareV2:MaterialExpressionTextureSampleParameter2D_0'",Mask=1,MaskR=1,MaskG=1,MaskB=1))
      Inputs(1)=(InputName="F",Input=(Expression="/Script/Engine.MaterialExpressionCustom'M_ArenaToothCareV2:MaterialExpressionCustom_1'"))
      Inputs(2)=(InputName="Pigment",Input=(Expression="/Script/Engine.MaterialExpressionCustom'M_ArenaToothCareV2:MaterialExpressionCustom_0'"))
      Inputs(3)=(InputName="Tint",Input=(Expression="/Script/Engine.MaterialExpressionVectorParameter'M_ArenaToothCareV2:MaterialExpressionVectorParameter_5'",Mask=1,MaskR=1,MaskG=1,MaskB=1))
      Inputs(4)=(InputName="Flash",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'M_ArenaToothCareV2:MaterialExpressionScalarParameter_6'"))
      MaterialExpressionEditorX=860
      MaterialExpressionEditorY=1360
      MaterialExpressionGuid=5CEB01F54D86516F17BDF2BAD6228551
      Material="/Script/Engine.Material'M_ArenaToothCareV2'"
   End Object
   Begin Object Name="MaterialExpressionCustom_1" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/Gameplay/Arena/V2/M_ArenaToothCareV2.M_ArenaToothCareV2:MaterialExpressionCustom_1'"
      Code="\nstruct Noise {\n float hash(float3 p) { return frac(sin(dot(p,float3(127.1,311.7,74.7)))*43758.5453); }\n float value(float3 p) {\n  float3 i=floor(p), f=frac(p); f=f*f*(3-2*f);\n  return lerp(lerp(lerp(hash(i),hash(i+float3(1,0,0)),f.x),lerp(hash(i+float3(0,1,0)),hash(i+float3(1,1,0)),f.x),f.y),\n              lerp(lerp(hash(i+float3(0,0,1)),hash(i+float3(1,0,1)),f.x),lerp(hash(i+float3(0,1,1)),hash(i+1),f.x),f.y),f.z);\n }\n}; Noise S;\n\nfloat3 uv=saturate((P-Minimum)/max(Size,.01))*15;\nfloat z0=floor(uv.z),z1=min(z0+1,15);\nfloat2 a=(uv.xy+float2(fmod(z0,4),floor(z0/4))*16+.5)/64;\nfloat2 b=(uv.xy+float2(fmod(z1,4),floor(z1/4))*16+.5)/64;\nfloat wipe=lerp(Texture2DSampleLevel(Wipe,WipeSampler,a,0).r,Texture2DSampleLevel(Wipe,WipeSampler,b,0).r,frac(uv.z));\nfloat3 q=P+Seed*float3(13.7,21.3,8.1);\nfloat grain=S.value(q*float3(.055,.052,.036)+4);\nfloat streak=S.value(q*float3(.12,.11,.022)+19);\nfloat flecks=S.value(q*.20);\nfloat h=uv.z/15;\nfloat band=smoothstep(.10,.25,h)*(1-smoothstep(.63,.84,h));\nfloat field=grain*.67+streak*.23+flecks*.10-(1-band)*.30;\nfloat threshold=lerp(.63,.51,Amount);\nfloat patch=smoothstep(threshold,threshold+.045,field);\nfloat dirt=0; // Visible coating is the continuous projected relief mesh.\nfloat distance=length((P-Brush)*Scale);\nfloat foam=(1-smoothstep(23,45,distance))*(1-smoothstep(.25,1.4,Age));\nfloat bubbles=smoothstep(.23,.49,S.value(P*.65));\nfoam*=lerp(.72,1,bubbles);\nfloat wet=(1-wipe)*patch;\nfloat crack=1-smoothstep(.025,.075,abs(sin(P.z*.044+P.y*.029+sin(P.y*.055)*.8)));\ncrack*=smoothstep(.15,.65,Damage)*smoothstep(-20,50,P.z);\nreturn float4(dirt,foam,wet,crack);\n"
      OutputType=CMOT_Float4
      Description="MC Care: localFilm"
      Inputs(0)=(InputName="P",Input=(Expression="/Script/Engine.MaterialExpressionVertexInterpolator'M_ArenaToothCareV2:MaterialExpressionVertexInterpolator_0'"))
      Inputs(1)=(InputName="Minimum",Input=(Expression="/Script/Engine.MaterialExpressionVectorParameter'M_ArenaToothCareV2:MaterialExpressionVectorParameter_0'",Mask=1,MaskR=1,MaskG=1,MaskB=1))
      Inputs(2)=(InputName="Size",Input=(Expression="/Script/Engine.MaterialExpressionVectorParameter'M_ArenaToothCareV2:MaterialExpressionVectorParameter_2'",Mask=1,MaskR=1,MaskG=1,MaskB=1))
      Inputs(3)=(InputName="Scale",Input=(Expression="/Script/Engine.MaterialExpressionVectorParameter'M_ArenaToothCareV2:MaterialExpressionVectorParameter_3'",Mask=1,MaskR=1,MaskG=1,MaskB=1))
      Inputs(4)=(InputName="Wipe",Input=(Expression="/Script/Engine.MaterialExpressionTextureObjectParameter'M_ArenaToothCareV2:MaterialExpressionTextureObjectParameter_0'"))
      Inputs(5)=(InputName="Amount",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'M_ArenaToothCareV2:MaterialExpressionScalarParameter_0'"))
      Inputs(6)=(InputName="Age",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'M_ArenaToothCareV2:MaterialExpressionScalarParameter_2'"))
      Inputs(7)=(InputName="Brush",Input=(Expression="/Script/Engine.MaterialExpressionVectorParameter'M_ArenaToothCareV2:MaterialExpressionVectorParameter_4'",Mask=1,MaskR=1,MaskG=1,MaskB=1))
      Inputs(8)=(InputName="Damage",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'M_ArenaToothCareV2:MaterialExpressionScalarParameter_5'"))
      Inputs(9)=(InputName="Seed",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'M_ArenaToothCareV2:MaterialExpressionScalarParameter_3'"))
      MaterialExpressionEditorX=430
      MaterialExpressionEditorY=1360
      MaterialExpressionGuid=3ADCC0D94A9639E245A9CA8A039F23E2
      Material="/Script/Engine.Material'M_ArenaToothCareV2'"
   End Object
   Begin Object Name="MaterialExpressionCustom_0" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/Gameplay/Arena/V2/M_ArenaToothCareV2.M_ArenaToothCareV2:MaterialExpressionCustom_0'"
      Code="\nfloat3 w=pow(abs(N),4); w/=max(dot(w,1),.001);\nreturn Texture2DSample(Tex,TexSampler,P.yz*.009).rgb*w.x+\n       Texture2DSample(Tex,TexSampler,P.xz*.009).rgb*w.y+\n       Texture2DSample(Tex,TexSampler,P.xy*.009).rgb*w.z;\n"
      Description="MC Care: pigmentColor"
      Inputs(0)=(InputName="P",Input=(Expression="/Script/Engine.MaterialExpressionVertexInterpolator'M_ArenaToothCareV2:MaterialExpressionVertexInterpolator_0'"))
      Inputs(1)=(InputName="N",Input=(Expression="/Script/Engine.MaterialExpressionVertexInterpolator'M_ArenaToothCareV2:MaterialExpressionVertexInterpolator_1'"))
      Inputs(2)=(InputName="Tex",Input=(Expression="/Script/Engine.MaterialExpressionTextureObjectParameter'M_ArenaToothCareV2:MaterialExpressionTextureObjectParameter_1'"))
      MaterialExpressionEditorY=1360
      MaterialExpressionGuid=9B45991244BABAEC3F075E97CFC13F24
      Material="/Script/Engine.Material'M_ArenaToothCareV2'"
   End Object
