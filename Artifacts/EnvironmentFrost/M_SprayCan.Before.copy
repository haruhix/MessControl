   Begin Object Name="MaterialExpressionCustom_2" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/Gameplay/Care/M_SprayCan.M_SprayCan:MaterialExpressionCustom_2'"
      Code="\nfloat label=smoothstep(.25,.27,UV.y)*(1-smoothstep(.70,.72,UV.y));\nfloat2 p=float2(frac(UV.x*3)-.5,UV.y-.48);\nfloat cross=max((1-step(.035,abs(p.x)))*(1-step(.14,abs(p.y))),(1-step(.11,abs(p.x)))*(1-step(.035,abs(p.y))));\nreturn lerp(float3(.78,.88,.85),lerp(float3(.025,.32,.20),float3(.9,.98,.96),cross),label);\n"
      Description="Spray can: clinic label"
      Inputs(0)=(InputName="UV",Input=(Expression="/Script/Engine.MaterialExpressionTextureCoordinate'M_SprayCan:MaterialExpressionTextureCoordinate_0'"))
      MaterialExpressionGuid=EE7295D54C510F5E401AAAA59DF64749
      Material="/Script/Engine.Material'M_SprayCan'"
   End Object
