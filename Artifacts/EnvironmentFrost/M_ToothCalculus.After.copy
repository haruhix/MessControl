   Begin Object Name="MaterialExpressionCustom_2" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/Gameplay/Care/M_ToothCalculus.M_ToothCalculus:MaterialExpressionCustom_2'"
      Code="return normalize(lerp(float3(0,0,1),Detail,saturate(Strength)*lerp(1,.3,saturate(Fresh))));"
      Description="Calculus: fine baked mineral pores"
      Inputs(0)=(InputName="Detail",Input=(Expression="/Script/Engine.MaterialExpressionTextureSampleParameter2D'M_ToothCalculus:MaterialExpressionTextureSampleParameter2D_1'",Mask=1,MaskR=1,MaskG=1,MaskB=1))
      Inputs(1)=(InputName="Strength",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'M_ToothCalculus:MaterialExpressionScalarParameter_4'"))
      Inputs(2)=(InputName="Fresh",Input=(Expression="/Script/Engine.MaterialExpressionVertexColor'M_ToothCalculus:MaterialExpressionVertexColor_1'",OutputIndex=4,Mask=1,MaskA=1))
      MaterialExpressionEditorX=-260
      MaterialExpressionEditorY=648
      MaterialExpressionGuid=B000E9C1484B982E7E7D89A2FA46742C
      Material="/Script/Engine.Material'M_ToothCalculus'"
   End Object
   Begin Object Name="MaterialExpressionCustom_1" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/Gameplay/Care/M_ToothCalculus.M_ToothCalculus:MaterialExpressionCustom_1'"
      Code="return lerp(clamp(Rough*(1-saturate(Damp)),.42,.78),.88,saturate(Fresh));"
      OutputType=CMOT_Float1
      Description="Calculus: damp crust and dry broken core"
      Inputs(0)=(InputName="Rough",Input=(Expression="/Script/Engine.MaterialExpressionTextureSampleParameter2D'M_ToothCalculus:MaterialExpressionTextureSampleParameter2D_2'",OutputIndex=1,Mask=1,MaskR=1))
      Inputs(1)=(InputName="Damp",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'M_ToothCalculus:MaterialExpressionScalarParameter_3'"))
      Inputs(2)=(InputName="Fresh",Input=(Expression="/Script/Engine.MaterialExpressionVertexColor'M_ToothCalculus:MaterialExpressionVertexColor_1'",OutputIndex=4,Mask=1,MaskA=1))
      MaterialExpressionEditorX=-260
      MaterialExpressionEditorY=486
      MaterialExpressionGuid=AC96E63546F9C3DA1507F6945F17027F
      Material="/Script/Engine.Material'M_ToothCalculus'"
   End Object
   Begin Object Name="MaterialExpressionCustom_0" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/Gameplay/Care/M_ToothCalculus.M_ToothCalculus:MaterialExpressionCustom_0'"
      Code="\nfloat pigment = saturate(dot(Vertex, float3(.25,.5,.25)));\nfloat3 crust = Aged * lerp(.92,1.08,pigment);\nfloat3 chalk = Chalk * lerp(.94,1.02,dot(Aged,float3(.333,.333,.333)));\nreturn lerp(crust,chalk,saturate(Fresh));\n"
      Description="Calculus: mineral pigment and fresh fracture"
      Inputs(0)=(InputName="Aged",Input=(Expression="/Script/Engine.MaterialExpressionTextureSampleParameter2D'M_ToothCalculus:MaterialExpressionTextureSampleParameter2D_0'",Mask=1,MaskR=1,MaskG=1,MaskB=1))
      Inputs(1)=(InputName="Vertex",Input=(Expression="/Script/Engine.MaterialExpressionVertexColor'M_ToothCalculus:MaterialExpressionVertexColor_1'",Mask=1,MaskR=1,MaskG=1,MaskB=1))
      Inputs(2)=(InputName="Fresh",Input=(Expression="/Script/Engine.MaterialExpressionVertexColor'M_ToothCalculus:MaterialExpressionVertexColor_1'",OutputIndex=4,Mask=1,MaskA=1))
      Inputs(3)=(InputName="Chalk",Input=(Expression="/Script/Engine.MaterialExpressionVectorParameter'M_ToothCalculus:MaterialExpressionVectorParameter_0'",Mask=1,MaskR=1,MaskG=1,MaskB=1))
      MaterialExpressionEditorX=-260
      MaterialExpressionGuid=E58114244DFFBA8D063C2AA406E22833
      Material="/Script/Engine.Material'M_ToothCalculus'"
   End Object
