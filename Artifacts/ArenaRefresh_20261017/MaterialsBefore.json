      {
        "cls": "MaterialExpressionCustom",
        "name": "MaterialExpressionCustom_6",
        "description": "Mouth climate frost crystal coverage",
        "desc": "",
        "code": "\nfloat grains=frac(sin(dot(floor(P*.9),float3(12.9898,78.233,45.164)))*43758.5453);\nfloat wisps=.5+.5*sin(P.x*.021+sin(P.y*.018)*2+P.z*.015);\nfloat coat=saturate(.38+.50*saturate(N.z)+.28*wisps+.12*grains);\nreturn saturate(Cold)*coat;\n"
      },
      {
        "cls": "MaterialExpressionCustom",
        "name": "MaterialExpressionCustom_7",
        "description": "Mouth climate frost color",
        "desc": "",
        "code": "return lerp(Base,float3(.65,.82,.93),Frost*.84);"
      },
      {
        "cls": "MaterialExpressionCustom",
        "name": "MaterialExpressionCustom_8",
        "description": "Mouth climate rough crystalline finish",
        "desc": "",
        "code": "return lerp(Rough,.58,Frost);"
      },
      {
        "cls": "MaterialExpressionMaterialFunctionCall",
        "name": "MaterialExpressionMaterialFunctionCall_0",
        "desc": "Shared matte fern frost; existing climate ColdAmount"
      }
