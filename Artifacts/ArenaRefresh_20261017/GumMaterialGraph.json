    {
      "cls": "MaterialExpressionCustom",
      "name": "MaterialExpressionCustom_0",
      "description": "Mouth climate frost crystal coverage",
      "desc": "",
      "code": "\nfloat grains=frac(sin(dot(floor(P*.9),float3(12.9898,78.233,45.164)))*43758.5453);\nfloat wisps=.5+.5*sin(P.x*.021+sin(P.y*.018)*2+P.z*.015);\nfloat coat=saturate(.38+.50*saturate(N.z)+.28*wisps+.12*grains);\nreturn saturate(Cold)*coat;\n"
    },
    {
      "cls": "MaterialExpressionCustom",
      "name": "MaterialExpressionCustom_1",
      "description": "Mouth climate frost color",
      "desc": "",
      "code": "return lerp(Base,float3(.65,.82,.93),Frost*.84);"
    },
    {
      "cls": "MaterialExpressionCustom",
      "name": "MaterialExpressionCustom_2",
      "description": "Mouth climate rough crystalline finish",
      "desc": "",
      "code": "return lerp(Rough,.58,Frost);"
    },
    {
      "cls": "MaterialExpressionTextureSampleParameter2D",
      "name": "MaterialExpressionTextureSampleParameter2D_3",
      "desc": "Baked distance to only the external SK_Exit boundary. UV0 follows morph animation.",
      "parameter_name": "Edge Distance Texture",
      "texture": "/Game/Art/Materials/ThroatEdgeFade/T_ExitOuterEdgeDistance.T_ExitOuterEdgeDistance"
    },
    {
      "cls": "MaterialExpressionScalarParameter",
      "name": "MaterialExpressionScalarParameter_0",
      "desc": "Fade width in mesh local centimetres, from 1 to 200. Larger values soften a wider border.",
      "parameter_name": "Edge Fade Width",
      "default_value": "100.0"
    },
    {
      "cls": "MaterialExpressionScalarParameter",
      "name": "MaterialExpressionScalarParameter_1",
      "desc": "0 restores the original visible border; 1 fully fades the external edge.",
      "parameter_name": "Edge Fade Amount",
      "default_value": "1.0"
    },
    {
      "cls": "MaterialExpressionCustom",
      "name": "MaterialExpressionCustom_3",
      "description": "Smooth transparency at the outer perimeter",
      "desc": "",
      "code": "float d = saturate(Distance) * 200.0;\nfloat edge = smoothstep(0.0, clamp(Width, 0.01, 200.0), d);\nreturn lerp(1.0, edge, saturate(Amount));"
    },
    {
      "cls": "MaterialExpressionMaterialFunctionCall",
      "name": "MaterialExpressionMaterialFunctionCall_0",
      "desc": "Temporal dithering preserves the existing lit surface."
    },
    {
      "cls": "MaterialExpressionMultiply",
      "name": "MaterialExpressionMultiply_0",
      "desc": "Keep the original material mask and add only the soft outer edge."
    },
    {
      "cls": "MaterialExpressionMaterialFunctionCall",
      "name": "MaterialExpressionMaterialFunctionCall_2",
      "desc": "Shared matte fern frost; existing climate ColdAmount"
    }
