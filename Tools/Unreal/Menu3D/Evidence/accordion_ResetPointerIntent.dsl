(fn ResetPointerIntent ()
  (bind pointer (Viewport|GetMousePositionOnViewport))
  (bind (mx my) (Math|Vector2D|BreakVector2D :InVec pointer))
  (Variables|Default|SetLastPointerX mx)
  (Variables|Default|SetLastPointerY my)
  (Variables|Default|SetPointerReady true)
  (Variables|Default|SetHasPointerMotion false)
  (Variables|Default|SetPendingHoverDay 0)
)