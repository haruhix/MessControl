(fn OnPreviewKeyDown (MyGeometry InKeyEvent)
  (bind key (Input|KeyEvent|GetKey :Input InKeyEvent))
  (bind display (Input|Key|GetKeyDisplayName :Key key :bLongDisplayName true))
  (bind name (Utilities|String|ToString(Text) :InText display))
  (if (or (Utilities|String|EqualExactly(String) name "Escape") (Utilities|String|EqualExactly(String) name "Gamepad Face Button Right"))
    (CallFunction|Back) (return (Widget|EventReply|Handled))
    (elif (and (== (Variables|Default|GetPageIndex) 1) (or (Utilities|String|EqualExactly(String) name "Down") (Utilities|String|EqualExactly(String) name "Gamepad D-pad Down")))
      (CallFunction|StepDay :Step 1) (return (Widget|EventReply|Handled))
      (elif (and (== (Variables|Default|GetPageIndex) 1) (or (Utilities|String|EqualExactly(String) name "Up") (Utilities|String|EqualExactly(String) name "Gamepad D-pad Up")))
        (CallFunction|StepDay :Step -1) (return (Widget|EventReply|Handled))
        (elif (and (not (or (Widget|HasKeyboardFocus :self (Variables|WBP_MainMenu3D|GetDay3CollapseButton)) (or (Widget|HasKeyboardFocus :self (Variables|WBP_MainMenu3D|GetDay2CollapseButton)) (or (Widget|HasKeyboardFocus :self (Variables|WBP_MainMenu3D|GetDay1CollapseButton)) (or (Widget|HasKeyboardFocus :self (Variables|WBP_MainMenu3D|GetDaysBackButton)) false))))) (and (== (Variables|Default|GetPageIndex) 1) (Utilities|String|EqualExactly(String) name "Enter")))
          (if (<= (Variables|Default|GetSelectedDay) 3)
            (if (and (== (Variables|Default|GetActiveDay) (Variables|Default|GetSelectedDay)) (or (and (== (Variables|Default|GetSelectedDay) 1) (> (Variables|Default|GetOpen1) 0.72)) (or (and (== (Variables|Default|GetSelectedDay) 2) (> (Variables|Default|GetOpen2) 0.72)) (or (and (== (Variables|Default|GetSelectedDay) 3) (> (Variables|Default|GetOpen3) 0.72)) false))))
              (CallFunction|OpenConnection)
              (else (CallFunction|SelectDay :Day (Variables|Default|GetSelectedDay)))))
          (return (Widget|EventReply|Handled))
          (else (return (Widget|EventReply|Unhandled)))))))
)