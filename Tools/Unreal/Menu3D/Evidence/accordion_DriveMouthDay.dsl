(fn DriveMouthDay (Day Open Height Center Hidden Scale)
  (bind isStage (or (== (Variables|Default|GetPageIndex) 1) (== (Variables|Default|GetPageIndex) 5)))
  (bind effectiveHidden (or Hidden (and isStage (or (<= (+ Center (* Height 0.5)) 80.5) (>= (- Center (* Height 0.5)) 819.5)))))
  (bind actors (select (== Day 1) (Variables|Default|GetDay1Actors) (select (== Day 2) (Variables|Default|GetDay2Actors) (select (== Day 3) (Variables|Default|GetDay3Actors) (select (== Day 4) (Variables|Default|GetDay4Actors) (select (== Day 5) (Variables|Default|GetDay5Actors) (select (== Day 6) (Variables|Default|GetDay6Actors) (Variables|Default|GetDay7Actors))))))))
  (for actor actors
    (Rendering|SetActorHiddenInGame :self actor :bNewHidden false)
    (bind loc (Transformation|GetActorLocation :self actor))
    (Transformation|SetActorLocation :self actor :NewLocation (Math|Vector|MakeVector :X (.x loc) :Y (.y loc) :Z (select (or (== (Variables|Default|GetPageIndex) 1) (== (Variables|Default|GetPageIndex) 5)) (- 450.0 Center) 0.0)) :bSweep false :bTeleport true)
    (Transformation|SetActorScale3D :self actor :NewScale3D (Math|Vector|MakeVector Scale Scale Scale))
    (bind sk (Utilities|Casting|CastToSkeletalMeshActor :Object actor)
      (:then (bind mesh (Class|SkeletalMeshActor|GetSkeletalMeshComponent :self sk))
        (if (!= (Class|SceneComponent|GetHiddeninGame :self mesh) effectiveHidden) (Development|SetHiddeninGame :self mesh :NewHidden false :bPropagateToChildren true))
        (bind bufferParity (Math|Conversions|ToFloat(Integer64) (Math|Integer64|%(integer64) :A (Utilities|GetFrameCount) :B 2)))
        (bind closedBufferFactor (Math|Float|Lerp :A 0.99999 :B 1.0 :Alpha bufferParity))
        (Components|SkeletalMesh|SetMorphTarget :self mesh :MorphTargetName "Pose_000" :Value (Math|Float|Lerp :A 0.0 :B (Math|Float|Clamp(Float) (- 1.0 (Math|Float|Absolute(Float) (* (- Open 0.0) 4.0))) 0.0 1.0) :Alpha closedBufferFactor) :bRemoveZeroWeight true)
        (Components|SkeletalMesh|SetMorphTarget :self mesh :MorphTargetName "Pose_025" :Value (Math|Float|Clamp(Float) (- 1.0 (Math|Float|Absolute(Float) (* (- Open 0.25) 4.0))) 0.0 1.0) :bRemoveZeroWeight true)
        (Components|SkeletalMesh|SetMorphTarget :self mesh :MorphTargetName "Pose_050" :Value (Math|Float|Clamp(Float) (- 1.0 (Math|Float|Absolute(Float) (* (- Open 0.5) 4.0))) 0.0 1.0) :bRemoveZeroWeight true)
        (Components|SkeletalMesh|SetMorphTarget :self mesh :MorphTargetName "Pose_075" :Value (Math|Float|Clamp(Float) (- 1.0 (Math|Float|Absolute(Float) (* (- Open 0.75) 4.0))) 0.0 1.0) :bRemoveZeroWeight true)
        (Rendering|Material|SetScalarParameterValueonMaterials :self mesh :ParameterName "OpenAmount" :ParameterValue Open)
        (Rendering|Material|SetScalarParameterValueonMaterials :self mesh :ParameterName "CardHalfHeight" :ParameterValue (select effectiveHidden -1.0 (/ (select (or (== (Variables|Default|GetPageIndex) 1) (== (Variables|Default|GetPageIndex) 5)) Height 370.0) (* 2.0 Scale)))))
      (:CastFailed))
  )
)
