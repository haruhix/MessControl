(fn OnMouseWheel (MyGeometry MouseEvent)
  (if (== (Variables|Default|GetPageIndex) 1)
    (CallFunction|ResetPointerIntent)
    (bind delta (Input|PointerEvent|GetWheelDelta :Input MouseEvent))
    (if (>= (Math|Float|Absolute(Float) delta) 0.5)
      (Variables|Default|SetWheelAccumulator 0.0)
      (CallFunction|StepDay :Step (select (< delta 0.0) 1 -1))
      (else
        (bind accumulated (+ (select (< (* (Variables|Default|GetWheelAccumulator) delta) 0.0) 0.0 (Variables|Default|GetWheelAccumulator)) delta))
        (Variables|Default|SetWheelAccumulator accumulated)
        (if (>= (Math|Float|Absolute(Float) (Variables|Default|GetWheelAccumulator)) 0.5)
          (CallFunction|StepDay :Step (select (< (Variables|Default|GetWheelAccumulator) 0.0) 1 -1))
          (Variables|Default|SetWheelAccumulator 0.0))))
    (return (Widget|EventReply|Handled))
    (else (return (Widget|EventReply|Unhandled))))
)