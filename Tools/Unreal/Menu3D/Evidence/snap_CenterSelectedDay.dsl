(fn CenterSelectedDay ()
  (Widget|ForceLayoutPrepass)
  (switch int (Variables|Default|GetSelectedDay)
    (:0)
    (:1 (Widget|ScrollWidgetIntoView :self (Variables|WBP_MainMenu3D|GetDayScroll) :WidgetToFind (Variables|WBP_MainMenu3D|GetDay1Size) :AnimateScroll true :ScrollDestination "Center" :Padding 0.0))
    (:2 (Widget|ScrollWidgetIntoView :self (Variables|WBP_MainMenu3D|GetDayScroll) :WidgetToFind (Variables|WBP_MainMenu3D|GetDay2Size) :AnimateScroll true :ScrollDestination "Center" :Padding 0.0))
    (:3 (Widget|ScrollWidgetIntoView :self (Variables|WBP_MainMenu3D|GetDayScroll) :WidgetToFind (Variables|WBP_MainMenu3D|GetDay3Size) :AnimateScroll true :ScrollDestination "Center" :Padding 0.0))
    (:4 (Widget|ScrollWidgetIntoView :self (Variables|WBP_MainMenu3D|GetDayScroll) :WidgetToFind (Variables|WBP_MainMenu3D|GetDay4Size) :AnimateScroll true :ScrollDestination "Center" :Padding 0.0))
    (:5 (Widget|ScrollWidgetIntoView :self (Variables|WBP_MainMenu3D|GetDayScroll) :WidgetToFind (Variables|WBP_MainMenu3D|GetDay5Size) :AnimateScroll true :ScrollDestination "Center" :Padding 0.0))
    (:6 (Widget|ScrollWidgetIntoView :self (Variables|WBP_MainMenu3D|GetDayScroll) :WidgetToFind (Variables|WBP_MainMenu3D|GetDay6Size) :AnimateScroll true :ScrollDestination "Center" :Padding 0.0))
    (:7 (Widget|ScrollWidgetIntoView :self (Variables|WBP_MainMenu3D|GetDayScroll) :WidgetToFind (Variables|WBP_MainMenu3D|GetDay7Size) :AnimateScroll true :ScrollDestination "Center" :Padding 0.0))
  )
)