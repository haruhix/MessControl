(fn Back ()
  (CallFunction|ResetPointerIntent)
  (Variables|Default|SetWheelAccumulator 0.0)
  (bind page (Variables|Default|GetPageIndex))
  (if (== page 0)
    (CallFunction|ShowPage :Index 4)
    (elif (== page 1)
      (if (> (Variables|Default|GetActiveDay) 0)
        (Variables|Default|SetActiveDay 0)
        (Variables|Default|SetHoverQuiet 1.2)
        (Variables|Default|SetSnapRemaining 1.0)
        (Widget|SetKeyboardFocus :self (Variables|WBP_MainMenu3D|GetDaysBackButton))
        (else (CallFunction|ShowPage :Index 0)))
      (elif (== page 5)
        (Widget|Panel|ClearChildren :self (Variables|WBP_MainMenu3D|GetLegacyMenuHost))
        (CallFunction|ShowPage :Index 1)
        (else (CallFunction|ShowPage :Index 0)))))
)