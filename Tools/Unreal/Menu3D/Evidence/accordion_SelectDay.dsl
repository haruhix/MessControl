(fn SelectDay (Day)
  (bind selected (Math|Integer|Clamp(Integer) :Value Day :Min 1 :Max 7))
  (CallFunction|ResetPointerIntent)
  (Variables|Default|SetWheelAccumulator 0.0)
  (Variables|Default|SetSelectedDay selected)
  (Variables|Default|SetActiveDay selected)
  (Variables|Default|SetWindowFirstDay (Math|Integer|Clamp(Integer) :Value (- selected 2) :Min 1 :Max 5))
  (Variables|Default|SetHoverQuiet 1.2)
  (Variables|Default|SetSnapRemaining 1.0)
  (CallFunction|CenterSelectedDay)
  (switch int selected
    (:0 (Widget|SetText(Text) :self (Variables|WBP_MainMenu3D|GetDayCounter) :InText "— / 07"))
    (:1 (Widget|SetText(Text) :self (Variables|WBP_MainMenu3D|GetDayCounter) :InText "01 / 07"))
    (:2 (Widget|SetText(Text) :self (Variables|WBP_MainMenu3D|GetDayCounter) :InText "02 / 07"))
    (:3 (Widget|SetText(Text) :self (Variables|WBP_MainMenu3D|GetDayCounter) :InText "03 / 07"))
    (:4 (Widget|SetText(Text) :self (Variables|WBP_MainMenu3D|GetDayCounter) :InText "04 / 07"))
    (:5 (Widget|SetText(Text) :self (Variables|WBP_MainMenu3D|GetDayCounter) :InText "05 / 07"))
    (:6 (Widget|SetText(Text) :self (Variables|WBP_MainMenu3D|GetDayCounter) :InText "06 / 07"))
    (:7 (Widget|SetText(Text) :self (Variables|WBP_MainMenu3D|GetDayCounter) :InText "07 / 07"))
  )
)