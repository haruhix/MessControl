(fn UpdateStage ()
  (bind page (Variables|Default|GetPageIndex))
  (bind isDays (== page 1))
  (bind dt (Utilities|Time|GetWorldDeltaSeconds))
  (bind scroll (Widget|GetScrollOffset :self (Variables|WBP_MainMenu3D|GetDayScroll)))
  (if (> (Math|Float|Absolute(Float) (- scroll (Variables|Default|GetLastScroll))) 0.1) (Variables|Default|SetHoverQuiet 0.18))
  (Variables|Default|SetLastScroll scroll)
  (Variables|Default|SetHoverQuiet (Math|Float|Clamp(Float) (- (Variables|Default|GetHoverQuiet) dt) 0.0 2.0))
  (bind first (Math|Integer|Clamp(Integer) :Value (Variables|Default|GetWindowFirstDay) :Min 1 :Max 5))
  (bind active (Variables|Default|GetActiveDay))
  (bind hovered (select (Widget|IsHovered :self (Variables|WBP_MainMenu3D|GetDay1Button)) 1 (select (Widget|IsHovered :self (Variables|WBP_MainMenu3D|GetDay2Button)) 2 (select (Widget|IsHovered :self (Variables|WBP_MainMenu3D|GetDay3Button)) 3 (select (Widget|IsHovered :self (Variables|WBP_MainMenu3D|GetDay4Button)) 4 (select (Widget|IsHovered :self (Variables|WBP_MainMenu3D|GetDay5Button)) 5 (select (Widget|IsHovered :self (Variables|WBP_MainMenu3D|GetDay6Button)) 6 (select (Widget|IsHovered :self (Variables|WBP_MainMenu3D|GetDay7Button)) 7 0))))))))
  (if (and isDays (and (<= (Variables|Default|GetSnapRemaining) 0.0) (and (> hovered 0) (and (!= hovered (Variables|Default|GetLastHoverDay)) (<= (Variables|Default|GetHoverQuiet) 0.0))))) (CallFunction|SelectDay :Day hovered))
  (Variables|Default|SetLastHoverDay hovered)
  (bind open1 (Math|Interpolation|FInterpTo :Current (Variables|Default|GetOpen1) :Target (select isDays (select (== active 1) 1.0 0.0) 0.0) :DeltaTime dt :InterpSpeed 9.0))
  (Variables|Default|SetOpen1 open1)
  (bind inWindow1 (and (>= 1 first) (< 1 (+ first 3))))
  (bind open2 (Math|Interpolation|FInterpTo :Current (Variables|Default|GetOpen2) :Target (select isDays (select (== active 2) 1.0 0.0) 0.0) :DeltaTime dt :InterpSpeed 9.0))
  (Variables|Default|SetOpen2 open2)
  (bind inWindow2 (and (>= 2 first) (< 2 (+ first 3))))
  (bind open3 (Math|Interpolation|FInterpTo :Current (Variables|Default|GetOpen3) :Target (select isDays (select (== active 3) 1.0 0.0) 1.0) :DeltaTime dt :InterpSpeed 9.0))
  (Variables|Default|SetOpen3 open3)
  (bind inWindow3 (and (>= 3 first) (< 3 (+ first 3))))
  (bind open4 (Math|Interpolation|FInterpTo :Current (Variables|Default|GetOpen4) :Target (select isDays (select (== active 4) 1.0 0.0) 0.0) :DeltaTime dt :InterpSpeed 9.0))
  (Variables|Default|SetOpen4 open4)
  (bind inWindow4 (and (>= 4 first) (< 4 (+ first 3))))
  (bind open5 (Math|Interpolation|FInterpTo :Current (Variables|Default|GetOpen5) :Target (select isDays (select (== active 5) 1.0 0.0) 0.0) :DeltaTime dt :InterpSpeed 9.0))
  (Variables|Default|SetOpen5 open5)
  (bind inWindow5 (and (>= 5 first) (< 5 (+ first 3))))
  (bind open6 (Math|Interpolation|FInterpTo :Current (Variables|Default|GetOpen6) :Target (select isDays (select (== active 6) 1.0 0.0) 0.0) :DeltaTime dt :InterpSpeed 9.0))
  (Variables|Default|SetOpen6 open6)
  (bind inWindow6 (and (>= 6 first) (< 6 (+ first 3))))
  (bind open7 (Math|Interpolation|FInterpTo :Current (Variables|Default|GetOpen7) :Target (select isDays (select (== active 7) 1.0 0.0) 0.0) :DeltaTime dt :InterpSpeed 9.0))
  (Variables|Default|SetOpen7 open7)
  (bind inWindow7 (and (>= 7 first) (< 7 (+ first 3))))
  (bind windowOpen (+ (+ (+ (+ (+ (+ (+ 0.0 (select inWindow1 open1 0.0)) (select inWindow2 open2 0.0)) (select inWindow3 open3 0.0)) (select inWindow4 open4 0.0)) (select inWindow5 open5 0.0)) (select inWindow6 open6 0.0)) (select inWindow7 open7 0.0)))
  (bind height1 (select inWindow1 (+ 246.666667 (- (* open1 185.0) (* windowOpen 61.666667))) 246.666667))
  (Layout|SizeBox|SetHeightOverride :self (Variables|WBP_MainMenu3D|GetDay1Size) :InHeightOverride height1)
  (if (and isDays (> open1 0.72)) (Widget|SetVisibility :self (Variables|WBP_MainMenu3D|GetDay1CavityControls) :InVisibility "SelfHitTestInvisible") (else (Widget|SetVisibility :self (Variables|WBP_MainMenu3D|GetDay1CavityControls) :InVisibility "Collapsed")))
  (bind height2 (select inWindow2 (+ 246.666667 (- (* open2 185.0) (* windowOpen 61.666667))) 246.666667))
  (Layout|SizeBox|SetHeightOverride :self (Variables|WBP_MainMenu3D|GetDay2Size) :InHeightOverride height2)
  (if (and isDays (> open2 0.72)) (Widget|SetVisibility :self (Variables|WBP_MainMenu3D|GetDay2CavityControls) :InVisibility "SelfHitTestInvisible") (else (Widget|SetVisibility :self (Variables|WBP_MainMenu3D|GetDay2CavityControls) :InVisibility "Collapsed")))
  (bind height3 (select inWindow3 (+ 246.666667 (- (* open3 185.0) (* windowOpen 61.666667))) 246.666667))
  (Layout|SizeBox|SetHeightOverride :self (Variables|WBP_MainMenu3D|GetDay3Size) :InHeightOverride height3)
  (if (and isDays (> open3 0.72)) (Widget|SetVisibility :self (Variables|WBP_MainMenu3D|GetDay3CavityControls) :InVisibility "SelfHitTestInvisible") (else (Widget|SetVisibility :self (Variables|WBP_MainMenu3D|GetDay3CavityControls) :InVisibility "Collapsed")))
  (bind height4 (select inWindow4 (+ 246.666667 (- (* open4 185.0) (* windowOpen 61.666667))) 246.666667))
  (Layout|SizeBox|SetHeightOverride :self (Variables|WBP_MainMenu3D|GetDay4Size) :InHeightOverride height4)
  (bind height5 (select inWindow5 (+ 246.666667 (- (* open5 185.0) (* windowOpen 61.666667))) 246.666667))
  (Layout|SizeBox|SetHeightOverride :self (Variables|WBP_MainMenu3D|GetDay5Size) :InHeightOverride height5)
  (bind height6 (select inWindow6 (+ 246.666667 (- (* open6 185.0) (* windowOpen 61.666667))) 246.666667))
  (Layout|SizeBox|SetHeightOverride :self (Variables|WBP_MainMenu3D|GetDay6Size) :InHeightOverride height6)
  (bind height7 (select inWindow7 (+ 246.666667 (- (* open7 185.0) (* windowOpen 61.666667))) 246.666667))
  (Layout|SizeBox|SetHeightOverride :self (Variables|WBP_MainMenu3D|GetDay7Size) :InHeightOverride height7)
  (bind center1 (+ 80.0 (- (+ 0.0 (* height1 0.5)) scroll)))
  (bind hidden1 (select isDays (or (< (+ center1 (* height1 0.5)) 80.0) (> (- center1 (* height1 0.5)) 820.0)) true))
  (bind scale1 (* 1.0 0.54))
  (CallFunction|DriveMouthDay :Day 1 :Open open1 :Height height1 :Center center1 :Hidden hidden1 :Scale scale1)
  (bind center2 (+ 80.0 (- (+ (+ 0.0 height1) (* height2 0.5)) scroll)))
  (bind hidden2 (select isDays (or (< (+ center2 (* height2 0.5)) 80.0) (> (- center2 (* height2 0.5)) 820.0)) true))
  (bind scale2 (* 1.0 0.54))
  (CallFunction|DriveMouthDay :Day 2 :Open open2 :Height height2 :Center center2 :Hidden hidden2 :Scale scale2)
  (bind center3 (+ 80.0 (- (+ (+ (+ 0.0 height1) height2) (* height3 0.5)) scroll)))
  (bind hidden3 (select isDays (or (< (+ center3 (* height3 0.5)) 80.0) (> (- center3 (* height3 0.5)) 820.0)) false))
  (bind scale3 (* 0.54 (- 1.12676056338 (* open3 0.12676056338))))
  (CallFunction|DriveMouthDay :Day 3 :Open open3 :Height height3 :Center center3 :Hidden hidden3 :Scale scale3)
  (bind center4 (+ 80.0 (- (+ (+ (+ (+ 0.0 height1) height2) height3) (* height4 0.5)) scroll)))
  (bind hidden4 (select isDays (or (< (+ center4 (* height4 0.5)) 80.0) (> (- center4 (* height4 0.5)) 820.0)) true))
  (bind scale4 (* 1.0 0.54))
  (CallFunction|DriveMouthDay :Day 4 :Open open4 :Height height4 :Center center4 :Hidden hidden4 :Scale scale4)
  (bind center5 (+ 80.0 (- (+ (+ (+ (+ (+ 0.0 height1) height2) height3) height4) (* height5 0.5)) scroll)))
  (bind hidden5 (select isDays (or (< (+ center5 (* height5 0.5)) 80.0) (> (- center5 (* height5 0.5)) 820.0)) true))
  (bind scale5 (* 1.0 0.54))
  (CallFunction|DriveMouthDay :Day 5 :Open open5 :Height height5 :Center center5 :Hidden hidden5 :Scale scale5)
  (bind center6 (+ 80.0 (- (+ (+ (+ (+ (+ (+ 0.0 height1) height2) height3) height4) height5) (* height6 0.5)) scroll)))
  (bind hidden6 (select isDays (or (< (+ center6 (* height6 0.5)) 80.0) (> (- center6 (* height6 0.5)) 820.0)) true))
  (bind scale6 (* 1.0 0.54))
  (CallFunction|DriveMouthDay :Day 6 :Open open6 :Height height6 :Center center6 :Hidden hidden6 :Scale scale6)
  (bind center7 (+ 80.0 (- (+ (+ (+ (+ (+ (+ (+ 0.0 height1) height2) height3) height4) height5) height6) (* height7 0.5)) scroll)))
  (bind hidden7 (select isDays (or (< (+ center7 (* height7 0.5)) 80.0) (> (- center7 (* height7 0.5)) 820.0)) true))
  (bind scale7 (* 1.0 0.54))
  (CallFunction|DriveMouthDay :Day 7 :Open open7 :Height height7 :Center center7 :Hidden hidden7 :Scale scale7)
  (for child (Variables|Default|GetInteriorActors)
    (Rendering|SetActorHiddenInGame :self child :bNewHidden (or hidden3 (< open3 0.05)))
    (bind staticActor (Utilities|Casting|CastToStaticMeshActor :Object child)
      (:then (bind staticMesh (Class|StaticMeshActor|GetStaticMeshComponent :self staticActor))
        (Rendering|Material|SetScalarParameterValueonMaterials :self staticMesh :ParameterName "CardHalfHeight" :ParameterValue (/ (select isDays height3 370.0) (* 2.0 scale3))))
      (:CastFailed))
  )
  (for child (Variables|Default|GetTongueActors)
    (Rendering|SetActorHiddenInGame :self child :bNewHidden (or hidden3 (< open3 0.05)))
    (bind staticActor (Utilities|Casting|CastToStaticMeshActor :Object child)
      (:then (bind staticMesh (Class|StaticMeshActor|GetStaticMeshComponent :self staticActor))
        (Rendering|Material|SetScalarParameterValueonMaterials :self staticMesh :ParameterName "CardHalfHeight" :ParameterValue (/ (select isDays height3 370.0) (* 2.0 scale3))))
      (:CastFailed))
  )
  (for child (Variables|Default|GetInterior1Actors)
    (Rendering|SetActorHiddenInGame :self child :bNewHidden (or hidden1 (< open1 0.05)))
    (bind staticActor (Utilities|Casting|CastToStaticMeshActor :Object child)
      (:then (bind staticMesh (Class|StaticMeshActor|GetStaticMeshComponent :self staticActor))
        (Rendering|Material|SetScalarParameterValueonMaterials :self staticMesh :ParameterName "CardHalfHeight" :ParameterValue (/ (select isDays height1 370.0) (* 2.0 scale1))))
      (:CastFailed))
  )
  (for child (Variables|Default|GetInterior2Actors)
    (Rendering|SetActorHiddenInGame :self child :bNewHidden (or hidden2 (< open2 0.05)))
    (bind staticActor (Utilities|Casting|CastToStaticMeshActor :Object child)
      (:then (bind staticMesh (Class|StaticMeshActor|GetStaticMeshComponent :self staticActor))
        (Rendering|Material|SetScalarParameterValueonMaterials :self staticMesh :ParameterName "CardHalfHeight" :ParameterValue (/ (select isDays height2 370.0) (* 2.0 scale2))))
      (:CastFailed))
  )
  (for child (Variables|Default|GetTongue1Actors)
    (Rendering|SetActorHiddenInGame :self child :bNewHidden (or hidden1 (< open1 0.05)))
    (bind staticActor (Utilities|Casting|CastToStaticMeshActor :Object child)
      (:then (bind staticMesh (Class|StaticMeshActor|GetStaticMeshComponent :self staticActor))
        (Rendering|Material|SetScalarParameterValueonMaterials :self staticMesh :ParameterName "CardHalfHeight" :ParameterValue (/ (select isDays height1 370.0) (* 2.0 scale1))))
      (:CastFailed))
  )
  (for child (Variables|Default|GetTongue2Actors)
    (Rendering|SetActorHiddenInGame :self child :bNewHidden (or hidden2 (< open2 0.05)))
    (bind staticActor (Utilities|Casting|CastToStaticMeshActor :Object child)
      (:then (bind staticMesh (Class|StaticMeshActor|GetStaticMeshComponent :self staticActor))
        (Rendering|Material|SetScalarParameterValueonMaterials :self staticMesh :ParameterName "CardHalfHeight" :ParameterValue (/ (select isDays height2 370.0) (* 2.0 scale2))))
      (:CastFailed))
  )
  (for child (Variables|Default|GetCharacterActors)
    (Rendering|SetActorHiddenInGame :self child :bNewHidden (or hidden3 (< open3 0.72)))
  )
  (for child (Variables|Default|GetCharacter1Actors)
    (Rendering|SetActorHiddenInGame :self child :bNewHidden (or hidden1 (< open1 0.72)))
  )
  (for child (Variables|Default|GetCharacter2Actors)
    (Rendering|SetActorHiddenInGame :self child :bNewHidden (or hidden2 (< open2 0.72)))
  )
  (Variables|Default|SetSnapRemaining (Math|Float|Clamp(Float) (- (Variables|Default|GetSnapRemaining) dt) 0.0 2.0))
  (if (and isDays (> (Variables|Default|GetSnapRemaining) 0.0)) (CallFunction|CenterSelectedDay))
)