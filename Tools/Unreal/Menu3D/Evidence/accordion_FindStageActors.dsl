(fn FindStageActors ()
  (bind day1 (Actor|GetAllActorswithTag :Tag "Menu3D_DAY01"))
  (Variables|Default|SetDay1Actors day1)
  (bind day2 (Actor|GetAllActorswithTag :Tag "Menu3D_DAY02"))
  (Variables|Default|SetDay2Actors day2)
  (bind day3 (Actor|GetAllActorswithTag :Tag "Menu3D_DAY03"))
  (Variables|Default|SetDay3Actors day3)
  (bind day4 (Actor|GetAllActorswithTag :Tag "Menu3D_DAY04"))
  (Variables|Default|SetDay4Actors day4)
  (bind day5 (Actor|GetAllActorswithTag :Tag "Menu3D_DAY05"))
  (Variables|Default|SetDay5Actors day5)
  (bind day6 (Actor|GetAllActorswithTag :Tag "Menu3D_DAY06"))
  (Variables|Default|SetDay6Actors day6)
  (bind day7 (Actor|GetAllActorswithTag :Tag "Menu3D_DAY07"))
  (Variables|Default|SetDay7Actors day7)
  (bind InteriorActors (Actor|GetAllActorswithTag :Tag "Menu3D_DAY03_Interior"))
  (Variables|Default|SetInteriorActors InteriorActors)
  (bind TongueActors (Actor|GetAllActorswithTag :Tag "Menu3D_DAY03_Tongue"))
  (Variables|Default|SetTongueActors TongueActors)
  (bind CharacterActors (Actor|GetAllActorswithTag :Tag "Menu3D_DAY03_Character"))
  (Variables|Default|SetCharacterActors CharacterActors)
  (bind Character1Actors (Actor|GetAllActorswithTag :Tag "Menu3D_DAY01_Character"))
  (Variables|Default|SetCharacter1Actors Character1Actors)
  (bind Character2Actors (Actor|GetAllActorswithTag :Tag "Menu3D_DAY02_Character"))
  (Variables|Default|SetCharacter2Actors Character2Actors)
  (bind Interior1Actors (Actor|GetAllActorswithTag :Tag "Menu3D_DAY01_Interior"))
  (Variables|Default|SetInterior1Actors Interior1Actors)
  (bind Interior2Actors (Actor|GetAllActorswithTag :Tag "Menu3D_DAY02_Interior"))
  (Variables|Default|SetInterior2Actors Interior2Actors)
  (bind Tongue1Actors (Actor|GetAllActorswithTag :Tag "Menu3D_DAY01_Tongue"))
  (Variables|Default|SetTongue1Actors Tongue1Actors)
  (bind Tongue2Actors (Actor|GetAllActorswithTag :Tag "Menu3D_DAY02_Tongue"))
  (Variables|Default|SetTongue2Actors Tongue2Actors)
)