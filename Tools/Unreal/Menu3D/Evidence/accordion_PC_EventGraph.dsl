(event EventBeginPlay
  (bind menu (UserInterface|CreateWidget :Class "/Game/UI/MainMenu3D/WBP_MainMenu3D.WBP_MainMenu3D_C" :OwningPlayer self))
  (Variables|Default|SetMenuWidget menu)
  (UserInterface|Viewport|AddtoViewport :self menu :ZOrder 50)
  (Input|SetInputModeUIOnly :PlayerController self :InWidgetToFocus menu :InMouseLockMode "DoNotLock" :bFlushInput true)
  (Variables|MouseInterface|SetShowMouseCursor :bShowMouseCursor true)
  (bind targets0 (Actor|GetAllActorswithTag :Tag "Menu3D_DAY01"))
  (for actor targets0
    (bind sk (Utilities|Casting|CastToSkeletalMeshActor :Object actor)
      (:then (bind mesh (Class|SkeletalMeshActor|GetSkeletalMeshComponent :self sk))
        (Class|SkinnedMeshComponent|SetVisibilityBasedAnimTickOption :self mesh :VisibilityBasedAnimTickOption "AlwaysTickPoseAndRefreshBones")
        (Class|SkinnedMeshComponent|SetEnableUpdateRateOptimizations :self mesh :bEnableUpdateRateOptimizations false)
        (Components|Tick|AddTickPrerequisiteActor :self mesh :PrerequisiteActor self))
      (:CastFailed)))
  (bind targets1 (Actor|GetAllActorswithTag :Tag "Menu3D_DAY02"))
