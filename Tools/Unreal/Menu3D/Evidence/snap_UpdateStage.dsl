(fn UpdateStage ()
  (bind page (Variables|Default|GetPageIndex))
  (bind isDays (== page 1))
  (bind dt (Utilities|Time|GetWorldDeltaSeconds))
  (bind scroll (Widget|GetScrollOffset :self (Variables|WBP_MainMenu3D|GetDayScroll)))
  (if (> (Math|Float|Absolute(Float) (- scroll (Variables|Default|GetLastScroll))) 0.1) (Variables|Default|SetHoverQuiet 0.18))
  (Variables|Default|SetLastScroll scroll)
  (Variables|Default|SetHoverQuiet (Math|Float|Clamp(Float) (- (Variables|Default|GetHoverQuiet) dt) 0.0 1.0))
  (bind owner (Widget|GetOwningPlayer))
  (bind hovered (select (Widget|IsHovered :self (Variables|WBP_MainMenu3D|GetDay1Button)) 1 (select (Widget|IsHovered :self (Variables|WBP_MainMenu3D|GetDay2Button)) 2 (select (Widget|IsHovered :self (Variables|WBP_MainMenu3D|GetDay3Button)) 3 0))))
  (if (and isDays (and (<= (Variables|Default|GetSnapRemaining) 0.0) (and (> hovered 0) (and (!= hovered (Variables|Default|GetLastHoverDay)) (<= (Variables|Default|GetHoverQuiet) 0.0))))) (CallFunction|SelectDay :Day hovered))
  (Variables|Default|SetLastHoverDay hovered)
  (bind active (Variables|Default|GetActiveDay))
  (bind open1 (Math|Interpolation|FInterpTo :Current (Variables|Default|GetOpen1) :Target (select isDays (select (== active 1) 1.0 0.0) 0.0) :DeltaTime dt :InterpSpeed 9.0))
  (Variables|Default|SetOpen1 open1)
  (bind height1 (+ 427.0 (* open1 254.0)))
  (Layout|SizeBox|SetHeightOverride :self (Variables|WBP_MainMenu3D|GetDay1Size) :InHeightOverride height1)
  (if (and isDays (> open1 0.72)) (Widget|SetVisibility :self (Variables|WBP_MainMenu3D|GetDay1CavityControls) :InVisibility "SelfHitTestInvisible") (else (Widget|SetVisibility :self (Variables|WBP_MainMenu3D|GetDay1CavityControls) :InVisibility "Collapsed")))
  (bind open2 (Math|Interpolation|FInterpTo :Current (Variables|Default|GetOpen2) :Target (select isDays (select (== active 2) 1.0 0.0) 0.0) :DeltaTime dt :InterpSpeed 9.0))
  (Variables|Default|SetOpen2 open2)
  (bind height2 (+ 427.0 (* open2 254.0)))
  (Layout|SizeBox|SetHeightOverride :self (Variables|WBP_MainMenu3D|GetDay2Size) :InHeightOverride height2)
  (if (and isDays (> open2 0.72)) (Widget|SetVisibility :self (Variables|WBP_MainMenu3D|GetDay2CavityControls) :InVisibility "SelfHitTestInvisible") (else (Widget|SetVisibility :self (Variables|WBP_MainMenu3D|GetDay2CavityControls) :InVisibility "Collapsed")))
  (bind open3 (Math|Interpolation|FInterpTo :Current (Variables|Default|GetOpen3) :Target (select isDays (select (== active 3) 1.0 0.0) 1.0) :DeltaTime dt :InterpSpeed 9.0))
  (Variables|Default|SetOpen3 open3)
  (bind height3 (+ 427.0 (* open3 254.0)))
  (Layout|SizeBox|SetHeightOverride :self (Variables|WBP_MainMenu3D|GetDay3Size) :InHeightOverride height3)
  (if (and isDays (> open3 0.72)) (Widget|SetVisibility :self (Variables|WBP_MainMenu3D|GetDay3CavityControls) :InVisibility "SelfHitTestInvisible") (else (Widget|SetVisibility :self (Variables|WBP_MainMenu3D|GetDay3CavityControls) :InVisibility "Collapsed")))
  (bind center1 (+ 80.0 (- (+ 370.0 (* height1 0.5)) scroll)))
  (bind hidden1 (select isDays (or (< (+ center1 (* height1 0.5)) 80.0) (> (- center1 (* height1 0.5)) 820.0)) true))
  (for actor (Variables|Default|GetDay1Actors)
    (Rendering|SetActorHiddenInGame :self actor :bNewHidden hidden1)
    (bind loc (Transformation|GetActorLocation :self actor))
    (Transformation|SetActorLocation :self actor :NewLocation (Math|Vector|MakeVector :X (.x loc) :Y (.y loc) :Z (select isDays (- 450.0 center1) 0.0)) :bSweep false :bTeleport true)
    (bind sk (Utilities|Casting|CastToSkeletalMeshActor :Object actor)
      (:then (bind mesh (Class|SkeletalMeshActor|GetSkeletalMeshComponent :self sk))
        (Components|SkeletalMesh|SetMorphTarget :self mesh :MorphTargetName "Pose_000" :Value (Math|Float|Clamp(Float) (- 1.0 (Math|Float|Absolute(Float) (* (- open1 0.0) 4.0))) 0.0 1.0) :bRemoveZeroWeight true)
        (Components|SkeletalMesh|SetMorphTarget :self mesh :MorphTargetName "Pose_025" :Value (Math|Float|Clamp(Float) (- 1.0 (Math|Float|Absolute(Float) (* (- open1 0.25) 4.0))) 0.0 1.0) :bRemoveZeroWeight true)
        (Components|SkeletalMesh|SetMorphTarget :self mesh :MorphTargetName "Pose_050" :Value (Math|Float|Clamp(Float) (- 1.0 (Math|Float|Absolute(Float) (* (- open1 0.5) 4.0))) 0.0 1.0) :bRemoveZeroWeight true)
        (Components|SkeletalMesh|SetMorphTarget :self mesh :MorphTargetName "Pose_075" :Value (Math|Float|Clamp(Float) (- 1.0 (Math|Float|Absolute(Float) (* (- open1 0.75) 4.0))) 0.0 1.0) :bRemoveZeroWeight true)
        (Rendering|Material|SetScalarParameterValueonMaterials :self mesh :ParameterName "OpenAmount" :ParameterValue open1))
      (:CastFailed))
  )
  (bind center2 (+ 80.0 (- (+ (+ 370.0 height1) (* height2 0.5)) scroll)))
  (bind hidden2 (select isDays (or (< (+ center2 (* height2 0.5)) 80.0) (> (- center2 (* height2 0.5)) 820.0)) true))
  (for actor (Variables|Default|GetDay2Actors)
    (Rendering|SetActorHiddenInGame :self actor :bNewHidden hidden2)
    (bind loc (Transformation|GetActorLocation :self actor))
    (Transformation|SetActorLocation :self actor :NewLocation (Math|Vector|MakeVector :X (.x loc) :Y (.y loc) :Z (select isDays (- 450.0 center2) 0.0)) :bSweep false :bTeleport true)
    (bind sk (Utilities|Casting|CastToSkeletalMeshActor :Object actor)
      (:then (bind mesh (Class|SkeletalMeshActor|GetSkeletalMeshComponent :self sk))
        (Components|SkeletalMesh|SetMorphTarget :self mesh :MorphTargetName "Pose_000" :Value (Math|Float|Clamp(Float) (- 1.0 (Math|Float|Absolute(Float) (* (- open2 0.0) 4.0))) 0.0 1.0) :bRemoveZeroWeight true)
        (Components|SkeletalMesh|SetMorphTarget :self mesh :MorphTargetName "Pose_025" :Value (Math|Float|Clamp(Float) (- 1.0 (Math|Float|Absolute(Float) (* (- open2 0.25) 4.0))) 0.0 1.0) :bRemoveZeroWeight true)
        (Components|SkeletalMesh|SetMorphTarget :self mesh :MorphTargetName "Pose_050" :Value (Math|Float|Clamp(Float) (- 1.0 (Math|Float|Absolute(Float) (* (- open2 0.5) 4.0))) 0.0 1.0) :bRemoveZeroWeight true)
        (Components|SkeletalMesh|SetMorphTarget :self mesh :MorphTargetName "Pose_075" :Value (Math|Float|Clamp(Float) (- 1.0 (Math|Float|Absolute(Float) (* (- open2 0.75) 4.0))) 0.0 1.0) :bRemoveZeroWeight true)
        (Rendering|Material|SetScalarParameterValueonMaterials :self mesh :ParameterName "OpenAmount" :ParameterValue open2))
      (:CastFailed))
  )
  (bind center3 (+ 80.0 (- (+ (+ (+ 370.0 height1) height2) (* height3 0.5)) scroll)))
  (bind hidden3 (select isDays (or (< (+ center3 (* height3 0.5)) 80.0) (> (- center3 (* height3 0.5)) 820.0)) false))
  (for actor (Variables|Default|GetDay3Actors)
    (Rendering|SetActorHiddenInGame :self actor :bNewHidden hidden3)
    (bind loc (Transformation|GetActorLocation :self actor))
    (Transformation|SetActorLocation :self actor :NewLocation (Math|Vector|MakeVector :X (.x loc) :Y (.y loc) :Z (select isDays (- 450.0 center3) 0.0)) :bSweep false :bTeleport true)
    (bind scale (- 1.12676056338 (* open3 0.12676056338)))
    (Transformation|SetActorScale3D :self actor :NewScale3D (Math|Vector|MakeVector scale scale scale))
    (bind sk (Utilities|Casting|CastToSkeletalMeshActor :Object actor)
      (:then (bind mesh (Class|SkeletalMeshActor|GetSkeletalMeshComponent :self sk))
        (Components|SkeletalMesh|SetMorphTarget :self mesh :MorphTargetName "Pose_000" :Value (Math|Float|Clamp(Float) (- 1.0 (Math|Float|Absolute(Float) (* (- open3 0.0) 4.0))) 0.0 1.0) :bRemoveZeroWeight true)
        (Components|SkeletalMesh|SetMorphTarget :self mesh :MorphTargetName "Pose_025" :Value (Math|Float|Clamp(Float) (- 1.0 (Math|Float|Absolute(Float) (* (- open3 0.25) 4.0))) 0.0 1.0) :bRemoveZeroWeight true)
        (Components|SkeletalMesh|SetMorphTarget :self mesh :MorphTargetName "Pose_050" :Value (Math|Float|Clamp(Float) (- 1.0 (Math|Float|Absolute(Float) (* (- open3 0.5) 4.0))) 0.0 1.0) :bRemoveZeroWeight true)
        (Components|SkeletalMesh|SetMorphTarget :self mesh :MorphTargetName "Pose_075" :Value (Math|Float|Clamp(Float) (- 1.0 (Math|Float|Absolute(Float) (* (- open3 0.75) 4.0))) 0.0 1.0) :bRemoveZeroWeight true)
        (Rendering|Material|SetScalarParameterValueonMaterials :self mesh :ParameterName "OpenAmount" :ParameterValue open3))
      (:CastFailed))
  )
  (for child (Variables|Default|GetInteriorActors) (Rendering|SetActorHiddenInGame :self child :bNewHidden (or hidden3 (< open3 0.05))))
  (for child (Variables|Default|GetTongueActors) (Rendering|SetActorHiddenInGame :self child :bNewHidden (or hidden3 (< open3 0.05))))
  (for child (Variables|Default|GetCharacterActors) (Rendering|SetActorHiddenInGame :self child :bNewHidden (or hidden3 (< open3 0.75))))
  (Variables|Default|SetSnapRemaining (Math|Float|Clamp(Float) (- (Variables|Default|GetSnapRemaining) dt) 0.0 2.0))
  (if (and isDays (> (Variables|Default|GetSnapRemaining) 0.0)) (CallFunction|CenterSelectedDay))
)