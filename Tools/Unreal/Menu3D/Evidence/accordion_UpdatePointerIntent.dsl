(fn UpdatePointerIntent ()
  (if (== (Variables|Default|GetPageIndex) 1)
    (bind pointer (Viewport|GetMousePositionOnViewport))
    (bind (mx my) (Math|Vector2D|BreakVector2D :InVec pointer))
    (bind platformPointer (Viewport|GetMousePositionOnPlatform))
    (bind absolutePointer (select (Variables|Default|GetHasPointerMotion) (Variables|Default|GetQueuedPointerScreen) platformPointer))
    (bind clipGeometry (Widget|GetCachedGeometry :self (Variables|WBP_MainMenu3D|GetDayScroll)))
    (bind row1Geometry (Widget|GetCachedGeometry :self (Variables|WBP_MainMenu3D|GetDay1Button)))
    (bind row2Geometry (Widget|GetCachedGeometry :self (Variables|WBP_MainMenu3D|GetDay2Button)))
    (bind row3Geometry (Widget|GetCachedGeometry :self (Variables|WBP_MainMenu3D|GetDay3Button)))
    (bind row4Geometry (Widget|GetCachedGeometry :self (Variables|WBP_MainMenu3D|GetDay4Button)))
    (bind row5Geometry (Widget|GetCachedGeometry :self (Variables|WBP_MainMenu3D|GetDay5Button)))
    (bind row6Geometry (Widget|GetCachedGeometry :self (Variables|WBP_MainMenu3D|GetDay6Button)))
    (bind row7Geometry (Widget|GetCachedGeometry :self (Variables|WBP_MainMenu3D|GetDay7Button)))
    (bind hovered (select (UserInterface|Geometry|IsUnderLocation :Geometry clipGeometry :AbsoluteCoordinate absolutePointer) (select (UserInterface|Geometry|IsUnderLocation :Geometry row1Geometry :AbsoluteCoordinate absolutePointer) 1 (select (UserInterface|Geometry|IsUnderLocation :Geometry row2Geometry :AbsoluteCoordinate absolutePointer) 2 (select (UserInterface|Geometry|IsUnderLocation :Geometry row3Geometry :AbsoluteCoordinate absolutePointer) 3 (select (UserInterface|Geometry|IsUnderLocation :Geometry row4Geometry :AbsoluteCoordinate absolutePointer) 4 (select (UserInterface|Geometry|IsUnderLocation :Geometry row5Geometry :AbsoluteCoordinate absolutePointer) 5 (select (UserInterface|Geometry|IsUnderLocation :Geometry row6Geometry :AbsoluteCoordinate absolutePointer) 6 (select (UserInterface|Geometry|IsUnderLocation :Geometry row7Geometry :AbsoluteCoordinate absolutePointer) 7 0))))))) 0))
    (if (Variables|Default|GetPointerReady)
      (if (and (Variables|Default|GetHasPointerMotion) (> (+ (* (- mx (Variables|Default|GetLastPointerX)) (- mx (Variables|Default|GetLastPointerX))) (* (- my (Variables|Default|GetLastPointerY)) (- my (Variables|Default|GetLastPointerY)))) 4.0))
        (Variables|Default|SetPendingHoverDay hovered)
        (Variables|Default|SetLastPointerX mx)
        (Variables|Default|SetLastPointerY my))
      (else (CallFunction|ResetPointerIntent)))
    (Variables|Default|SetHasPointerMotion false)
    (if (and (<= (Variables|Default|GetSnapRemaining) 0.0) (<= (Variables|Default|GetHoverQuiet) 0.0))
      (if (and (> (Variables|Default|GetPendingHoverDay) 0) (and (== (Variables|Default|GetPendingHoverDay) hovered) (!= (Variables|Default|GetPendingHoverDay) (Variables|Default|GetActiveDay))))
        (CallFunction|SelectDay :Day (Variables|Default|GetPendingHoverDay))
        (else (Variables|Default|SetPendingHoverDay 0))))
    (else (CallFunction|ResetPointerIntent)))
)